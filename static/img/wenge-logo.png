					<a
						href="/cityMini/site/research"
						class="block py-4 border-b border-gray-100 text-base font-bold text-modern-dark hover:text-indigo-600"
						>AI研究</a
					>
					<a
						href="/cityMini/site/69b27b0de4b081dd044b8f0d"
						class="block py-4 border-b border-gray-100 text-base font-bold text-modern-dark hover:text-indigo-600"
						>闻歌资讯</a
					>
					
					<a
						href="/cityMini/site/experience"
						target="_blank"
						class="block py-4 border-b border-gray-100 text-base font-bold text-modern-dark hover:text-indigo-600"
						>产品试用</a
					>
					<a
						href="/cityMini/site/about"
						class="block py-4 border-b border-gray-100 text-base font-bold text-modern-dark hover:text-indigo-600"
						>关于我们</a
