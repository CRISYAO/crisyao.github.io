<script>
	function getFooterYAYIUrl() {
		try {
			if (typeof window.getYAYIProductUrl === 'function') {
				return window.getYAYIProductUrl()
			}

			if (window.i18n && typeof window.i18n.getCurrentLanguage === 'function') {
				return window.i18n.getCurrentLanguage() === 'en'
					? 'https://YAYI.wenge.com/maas/?lang=en'
					: 'https://YAYI.wenge.com/maas/#/HeaderNav/home'
			}

			const savedLang = localStorage.getItem('wenge_lang') || localStorage.getItem('lang')
			return savedLang === 'en'
				? 'https://YAYI.wenge.com/maas/?lang=en'
				: 'https://YAYI.wenge.com/maas/#/HeaderNav/home'
		} catch (error) {
			return 'https://YAYI.wenge.com/maas/#/HeaderNav/home'
		}
	}

	function syncFooterYAYILinks() {
		const targetUrl = getFooterYAYIUrl()
		document.querySelectorAll('[data-YAYI-link="true"]').forEach(link => {
			link.setAttribute('href', targetUrl)
		})
	}

	syncFooterYAYILinks()
	window.addEventListener('languageChanged', syncFooterYAYILinks)

	if (typeof lucide !== 'undefined') lucide.createIcons()
</script>


		<!-- 视频播放器弹窗 -->
		<div id="video-modal" class="fixed inset-0 z-[9999] hidden">
			<!-- 蒙层 -->
			<div id="video-overlay" class="absolute inset-0 bg-black/80"></div>
			<!-- 播放器容器 -->
			<div class="absolute inset-0 flex items-center justify-center p-4 md:p-8">
				<div
					class="relative w-full max-w-5xl aspect-video bg-black rounded-lg overflow-hidden shadow-2xl"
				>
					<!-- 关闭按钮 -->
					<button
						id="close-video-modal"
						class="absolute top-3 right-3 z-10 w-10 h-10 rounded-full bg-black/50 hover:bg-black/70 flex items-center justify-center text-white transition-colors"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
					<!-- 视频元素 -->
					<video id="video-player" controls class="w-full h-full"></video>
				</div>
			</div>
		</div>
		<!-- Interactive Scripts -->
		<script>
			lucide.createIcons()

			// 导航栏滚动交互
			window.addEventListener('scroll', () => {
				const nav = document.querySelector('nav')
				if (window.scrollY > 20) {
					nav.classList.add('shadow-sm')
					nav.classList.replace('bg-white/80', 'bg-white/95')
				} else {
					nav.classList.remove('shadow-sm')
					nav.classList.replace('bg-white/95', 'bg-white/80')
				}
			})

			// 核心驱动引擎卡片滑动交互
			initEngineSlider()

			// 核心驱动引擎标签切换功能
			function initEngineSlider() {
				const tabs = document.querySelectorAll('.engine-tab')
				const contents = document.querySelectorAll('.engine-content')

				if (tabs.length === 0 || contents.length === 0) return

				// 标签点击事件
				tabs.forEach((tab, index) => {
					tab.addEventListener('click', () => {
						// 更新标签样式
						tabs.forEach(t => {
							t.classList.remove('active', 'bg-indigo-600', 'text-white', 'shadow-lg')
							t.classList.add('bg-gray-100', 'text-gray-600', 'hover:bg-gray-200')
						})
						tab.classList.add('active', 'bg-indigo-600', 'text-white', 'shadow-lg')
						tab.classList.remove('bg-gray-100', 'text-gray-600', 'hover:bg-gray-200')

						// 更新内容显示
						contents.forEach((content, contentIndex) => {
							if (contentIndex === index) {
								content.classList.remove('hidden')
								content.classList.add('active')
							} else {
								content.classList.add('hidden')
								content.classList.remove('active')
							}
						})
					})
				})
			}

			// 前沿与研究轮播功能
			let currentSlide = 0
			const totalSlides = 2

			function updateCarousel() {
				const slides = document.querySelectorAll('.carousel-slide')
				const dots = document.querySelectorAll('.carousel-dot')

				slides.forEach((slide, index) => {
					if (index === currentSlide) {
						slide.classList.remove('opacity-0')
						slide.classList.add('opacity-100')
					} else {
						slide.classList.remove('opacity-100')
						slide.classList.add('opacity-0')
					}
				})

				dots.forEach((dot, index) => {
					if (index === currentSlide) {
						dot.classList.remove('bg-gray-300')
						dot.classList.add('bg-indigo-600', 'w-6')
					} else {
						dot.classList.remove('bg-indigo-600', 'w-6')
						dot.classList.add('bg-gray-300')
					}
				})
			}

			function nextSlide() {
				currentSlide = (currentSlide + 1) % totalSlides
				updateCarousel()
			}

			function prevSlide() {
				currentSlide = (currentSlide - 1 + totalSlides) % totalSlides
				updateCarousel()
			}

			function goToSlide(index) {
				currentSlide = index
				updateCarousel()
			}

			// 自动轮播
			setInterval(() => {
				nextSlide()
			}, 5000)

			// 核心驱动引擎滑动切换功能 - 无限循环
			let currentEngineSlide = 0
			const originalCardCount = 5 // 原始卡片数量
			const maxSlideIndex = 4 // 最大滑动索引（0-4，共5个位置）
			let isTransitioning = false

			function getSlideOffset(slideIndex) {
				// 计算精确偏移量：每张卡片占 (50% - 12px) + 24px gap
				// 即每张卡片实际占据的空间是 50% + 12px
				// 但为了简化，我们使用像素计算
				const container = document.getElementById('engineSlider')
				if (!container) return 0

				const containerWidth = container.parentElement.offsetWidth
				const gap = 24 // gap-6 = 24px
				const cardWidth = (containerWidth - gap) / 2 // 每张卡片宽度
				const slideDistance = cardWidth + gap // 每次滑动的距离

				return slideIndex * slideDistance
			}

			function updateEngineSlider(animate = true) {
				const slider = document.getElementById('engineSlider')
				const dots = document.querySelectorAll('.engine-dot')

				if (slider) {
					// 控制动画过渡
					if (animate) {
						slider.classList.add('transition-transform', 'duration-500', 'ease-out')
					} else {
						slider.classList.remove('transition-transform', 'duration-500', 'ease-out')
					}

					// 计算精确偏移量
					const offset = getSlideOffset(currentEngineSlide)
					slider.style.transform = `translateX(-${offset}px)`
				}

				// 更新指示点（使用模运算对应到原始5张卡片）
				const dotIndex = currentEngineSlide % originalCardCount
				dots.forEach((dot, index) => {
					if (index === dotIndex) {
						dot.classList.remove('bg-gray-300')
						dot.classList.add('bg-indigo-600')
					} else {
						dot.classList.remove('bg-indigo-600')
						dot.classList.add('bg-gray-300')
					}
				})
			}

			function nextEngineSlide() {
				if (isTransitioning) return
				isTransitioning = true

				currentEngineSlide++
				updateEngineSlider(true)

				// 如果滑动到复制的卡片区域（第5个位置及以后），在动画结束后瞬间重置回开头
				if (currentEngineSlide > maxSlideIndex) {
					setTimeout(() => {
						currentEngineSlide = 0
						updateEngineSlider(false) // 无动画重置
						isTransitioning = false
					}, 500) // 等待动画完成
				} else {
					setTimeout(() => {
						isTransitioning = false
					}, 500)
				}
			}

			function prevEngineSlide() {
				if (isTransitioning) return
				isTransitioning = true

				// 如果在开头，先瞬间跳转到复制的最后区域
				if (currentEngineSlide === 0) {
					currentEngineSlide = maxSlideIndex + 1
					updateEngineSlider(false) // 无动画跳转

					// 强制重绘
					setTimeout(() => {
						currentEngineSlide = maxSlideIndex
						updateEngineSlider(true) // 有动画滑动到前一个
						setTimeout(() => {
							isTransitioning = false
						}, 500)
					}, 50)
				} else {
					currentEngineSlide--
					updateEngineSlider(true)
					setTimeout(() => {
						isTransitioning = false
					}, 500)
				}
			}

			// 前沿与研究 - 分类筛选功能
			function initResearchFilter() {
				const filterBtns = document.querySelectorAll('.research-filter-btn')
				const researchCards = document.querySelectorAll('.research-card')

				// 筛选函数
				function filterCards(filter) {
					researchCards.forEach(card => {
						const category = card.dataset.category
						if (category === filter) {
							card.style.display = 'block'
							// 添加淡入动画
							card.style.opacity = '0'
							card.style.transform = 'translateY(10px)'
							setTimeout(() => {
								card.style.transition = 'opacity 0.3s ease, transform 0.3s ease'
								card.style.opacity = '1'
								card.style.transform = 'translateY(0)'
							}, 50)
						} else {
							card.style.display = 'none'
						}
					})
				}

				// 初始化：获取默认选中的分类并筛选
				const activeBtn = document.querySelector('.research-filter-btn.active')
				if (activeBtn) {
					const defaultFilter = activeBtn.dataset.filter
					filterCards(defaultFilter)
				}

				filterBtns.forEach(btn => {
					btn.addEventListener('click', () => {
						const filter = btn.dataset.filter

						// 更新按钮样式 - 左侧边框导航样式
						filterBtns.forEach(b => {
							b.classList.remove('active', 'border-indigo-600', 'text-indigo-600', 'font-bold')
							b.classList.add('border-transparent', 'text-slate-600')
						})
						btn.classList.remove('border-transparent', 'text-slate-600')
						btn.classList.add('active', 'border-indigo-600', 'text-indigo-600', 'font-bold')

						// 筛选卡片
						filterCards(filter)
					})
				})
			}
			const iframe = document.getElementById('architectureIframe')

			// 2. 监听 iframe 发来的消息
		window.addEventListener('message', event => {
				const { data } = event

				if (data?.type !== 'doma:layer-click') return
				if (data?.action !== 'navigate' || !data?.targetUrl) return

				const popup = window.open(data.targetUrl, '_blank', 'noopener,noreferrer')
				if (popup) popup.opener = null
			})
			// 初始化研究筛选
			// document.addEventListener('DOMContentLoaded', initResearchFilter)

			// 客户评价轮播
			function initTestimonialCarousel() {
				const slides = document.querySelectorAll('.testimonial-slide')
				const dots = document.querySelectorAll('.testimonial-dot')
				let currentSlide = 0
				const totalSlides = slides.length

				function showSlide(index) {
					slides.forEach((slide, i) => {
						slide.classList.toggle('active', i === index)
					})
					dots.forEach((dot, i) => {
						dot.classList.toggle('bg-indigo-500', i === index)
						dot.classList.toggle('bg-gray-300', i !== index)
					})
				}

				function nextSlide() {
					currentSlide = (currentSlide + 1) % totalSlides
					showSlide(currentSlide)
				}

				// 自动轮播，每5秒切换一次
				setInterval(nextSlide, 5000)

				// 点击指示器切换
				dots.forEach((dot, index) => {
					dot.addEventListener('click', () => {
						currentSlide = index
						showSlide(currentSlide)
					})
				})

				// 初始化显示第一个
				showSlide(0)
			}

			document.addEventListener('DOMContentLoaded', initTestimonialCarousel)

			// --- 3. 滚动入场监听 (Reveal) ---
			const observerOptions = { root: null, rootMargin: '0px', threshold: 0.15 }
			const observer = new IntersectionObserver((entries, observer) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('active')
					}
				})
			}, observerOptions)
			document.querySelectorAll('.reveal').forEach(el => observer.observe(el))

			// --- 4. 首屏 Three.js 星空隧道与推演系统 ---
			const container = document.getElementById('canvas-container')
			const decitronHeroSection = container ? container.closest('.hero-section') : null
			let decitronActive = decitronHeroSection
				? decitronHeroSection.classList.contains('hero-section--active')
				: true
			let decitronRafId = 0
			const scene = new THREE.Scene()
			scene.fog = new THREE.FogExp2(0x030b1e, 0.0012)

			const camera = new THREE.PerspectiveCamera(
				60,
				window.innerWidth / window.innerHeight,
				0.1,
				3000
			)
			camera.position.set(-180, 0, 400)
			camera.lookAt(150, 0, 0)

			const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true })
			renderer.setSize(window.innerWidth, window.innerHeight)
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))
			container.appendChild(renderer.domElement)

			const particleCount = 8000
			const geometry = new THREE.BufferGeometry()
			const positions = new Float32Array(particleCount * 3)
			const colors = new Float32Array(particleCount * 3)
			const sizes = new Float32Array(particleCount)

			const colorBlue = new THREE.Color(0x3b82f6)
			const colorDeepBlue = new THREE.Color(0x1e3a8a)
			const colorGold = new THREE.Color(0xfbbf24)
			const colorWhite = new THREE.Color(0xffffff)

			for (let i = 0; i < particleCount; i++) {
				const radius = 80 + Math.random() * 450
				const theta = Math.random() * Math.PI * 2
				const z = (Math.random() - 0.5) * 4000

				positions[i * 3] = Math.cos(theta) * radius
				positions[i * 3 + 1] = Math.sin(theta) * radius
				positions[i * 3 + 2] = z

				const isGold = Math.random() > 0.85
				const pColor = new THREE.Color()

				if (isGold) pColor.copy(colorGold).lerp(colorWhite, Math.random() * 0.6)
				else pColor.copy(colorBlue).lerp(colorDeepBlue, Math.random())

				colors[i * 3] = pColor.r
				colors[i * 3 + 1] = pColor.g
				colors[i * 3 + 2] = pColor.b

				sizes[i] = Math.random() * 2 + (isGold ? 1 : 0)
			}

			geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3))
			geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3))
			geometry.setAttribute('size', new THREE.BufferAttribute(sizes, 1))

			const material = new THREE.PointsMaterial({
				size: 3,
				vertexColors: true,
				blending: THREE.AdditiveBlending,
				transparent: true,
				opacity: 0.9,
				sizeAttenuation: true,
				depthWrite: false
			})

			const particles = new THREE.Points(geometry, material)
			scene.add(particles)

			function createGlowTexture(colorStr) {
				const canvas = document.createElement('canvas')
				canvas.width = 64
				canvas.height = 64
				const ctx = canvas.getContext('2d')
				const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32)
				gradient.addColorStop(0, colorStr)
				gradient.addColorStop(0.3, colorStr.replace(',1)', ',0.8)'))
				gradient.addColorStop(1, colorStr.replace(',1)', ',0)'))
				ctx.fillStyle = gradient
				ctx.fillRect(0, 0, 64, 64)
				return new THREE.CanvasTexture(canvas)
			}

			const goldGlowTex = createGlowTexture('rgba(251,191,36,1)')
			const blueGlowTex = createGlowTexture('rgba(59,130,246,1)')

			function createGlowingNode(type = 'normal', scale = 1) {
				const group = new THREE.Group()
				let isGold = type === 'best' || type === 'history'
				let colorHex = isGold ? 0xfef08a : 0xbfdbfe
				let glowColorHex = isGold ? 0xfbbf24 : 0x3b82f6
				let glowTex = isGold ? goldGlowTex : blueGlowTex

				const coreGeo = new THREE.SphereGeometry(3 * scale, 16, 16)
				const coreMat = new THREE.MeshBasicMaterial({ color: colorHex })
				const core = new THREE.Mesh(coreGeo, coreMat)

				const glowMat = new THREE.SpriteMaterial({
					map: glowTex,
					color: glowColorHex,
					transparent: true,
					blending: THREE.AdditiveBlending,
					opacity: isGold ? 1 : 0.7
				})
				const glow = new THREE.Sprite(glowMat)
				glow.scale.set(35 * scale, 35 * scale, 1)

				gsap.to(glow.scale, {
					x: 45 * scale,
					y: 45 * scale,
					duration: 1 + Math.random(),
					yoyo: true,
					repeat: -1,
					ease: 'sine.inOut'
				})

				group.add(core)
				group.add(glow)
				return group
			}

			const branchGroup = new THREE.Group()
			const rewindGroup = new THREE.Group()
			scene.add(branchGroup)
			scene.add(rewindGroup)

			window.addEventListener('resize', () => {
				camera.aspect = window.innerWidth / window.innerHeight
				camera.updateProjectionMatrix()
				renderer.setSize(window.innerWidth, window.innerHeight)
			})

			let state = {
				speed: 0.5,
				targetSpeed: 0.5,
				rotationSpeed: 0.0005,
				mode: 'idle',
				isAnimating: false
			}

			const uiLayer = document.getElementById('node-ui-layer')
			const statusHint = document.getElementById('status-hint')

			let activeMiniNode = null
			let activeMiniNodeUI = null

			function getLang() {
				return document.body.getAttribute('data-lang') || 'zh'
			}

			function setHint(textZh, textEn) {
				if (!textZh) {
					gsap.to(statusHint, { opacity: 0, duration: 0.3 })
				} else {
					statusHint.innerText = getLang() === 'en' ? textEn || textZh : textZh
					gsap.to(statusHint, { opacity: 1, duration: 0.3 })
				}
			}

			function clearUI() {
				activeMiniNode = null
				activeMiniNodeUI = null
				gsap.to(uiLayer.children, {
					opacity: 0,
					scale: 0.9,
					duration: 0.4,
					onComplete: () => {
						uiLayer.innerHTML = ''
					}
				})
			}

			function animate() {
				if (!decitronActive || document.hidden) {
					decitronRafId = 0
					return
				}
				decitronRafId = requestAnimationFrame(animate)
				state.speed += (state.targetSpeed - state.speed) * 0.05

				const posAttr = particles.geometry.attributes.position
				const positionsArray = posAttr.array

				for (let i = 0; i < particleCount; i++) {
					let x = positionsArray[i * 3]
					let y = positionsArray[i * 3 + 1]
					let z = positionsArray[i * 3 + 2]

					z += state.speed
					if (state.speed > 0 && z > 2000) z -= 4000
					if (state.speed < 0 && z < -2000) z += 4000

					let cos = Math.cos(state.rotationSpeed)
					let sin = Math.sin(state.rotationSpeed)
					let nx = x * cos - y * sin
					let ny = x * sin + y * cos

					positionsArray[i * 3] = nx
					positionsArray[i * 3 + 1] = ny
					positionsArray[i * 3 + 2] = z
				}
				posAttr.needsUpdate = true

				if (activeMiniNode && activeMiniNodeUI) {
					const vector = new THREE.Vector3()
					activeMiniNode.getWorldPosition(vector)
					vector.project(camera)

					const x = (vector.x * 0.5 + 0.5) * window.innerWidth
					const y = (vector.y * -0.5 + 0.5) * window.innerHeight

					let uiX = x - 300
					let uiY = y - 40

					const safeZoneMinX = window.innerWidth * 0.45
					if (uiX < safeZoneMinX) {
						uiX = safeZoneMinX
					}

					activeMiniNodeUI.style.left = `${uiX}px`
					activeMiniNodeUI.style.top = `${uiY}px`
				}

				renderer.render(scene, camera)
			}
			function startDecitronAnimation() {
				if (decitronRafId || !decitronActive || document.hidden) return
				decitronRafId = requestAnimationFrame(animate)
			}

			function stopDecitronAnimation() {
				if (decitronRafId) {
					cancelAnimationFrame(decitronRafId)
					decitronRafId = 0
				}
			}

			document.addEventListener('hero:slidechange', e => {
				const activeSection = e && e.detail ? e.detail.section : null
				decitronActive = activeSection === decitronHeroSection
				if (decitronActive) startDecitronAnimation()
				else stopDecitronAnimation()
			})

			document.addEventListener('visibilitychange', () => {
				if (document.hidden) stopDecitronAnimation()
				else if (decitronActive) startDecitronAnimation()
			})

			startDecitronAnimation()

			// 核心能力轮播功能
			function initCapabilityCarousel() {
				const track = document.getElementById('capabilityTrack')
				const prevBtn = document.getElementById('capabilityPrev')
				const nextBtn = document.getElementById('capabilityNext')
				const cards = document.querySelectorAll('.capability-card')

				if (!track || cards.length === 0) return

				let currentIndex = 0
				const totalCards = cards.length
				let autoPlayInterval
				let isDragging = false
				let startX = 0
				let scrollLeft = 0

				// 获取卡片宽度（包括间距）
				function getCardWidth() {
					const containerWidth = track.parentElement.offsetWidth
					// 移动端显示1张，桌面端显示2张
					return containerWidth / VISIBLE_CARDS
				}

				// 根据屏幕宽度计算可见卡片数
				function getVisibleCards() {
					return window.innerWidth < 768 ? 1 : 3
				}

				let VISIBLE_CARDS = getVisibleCards()
				const STEP_CARDS = 1
				let maxIndex = totalCards - VISIBLE_CARDS // 索引范围

				// 更新轮播位置
				function updateCarousel(index, animate = true) {
					// 循环索引
					currentIndex = index

					const cardWidth = getCardWidth()
					const offset = currentIndex * cardWidth
					track.style.transform = `translateX(-${offset}px)`

					// 循环模式下按钮始终可用
					if (prevBtn) {
						prevBtn.style.opacity = '1'
						prevBtn.style.pointerEvents = 'auto'
					}
					if (nextBtn) {
						nextBtn.style.opacity = '1'
						nextBtn.style.pointerEvents = 'auto'
					}
				}

				// 下一张（循环）
				function next() {
					if (currentIndex >= maxIndex) {
						updateCarousel(0) // 到最后一张时循环回第一张
					} else {
						updateCarousel(currentIndex + STEP_CARDS)
					}
				}

				// 上一张（循环）
				function prev() {
					if (currentIndex <= 0) {
						updateCarousel(maxIndex) // 到第一张时循环回最后一张
					} else {
						updateCarousel(currentIndex - STEP_CARDS)
					}
				}

				// 绑定按钮事件
				if (prevBtn)
					prevBtn.addEventListener('click', () => {
						prev()
						resetAutoPlay()
					})
				if (nextBtn)
					nextBtn.addEventListener('click', () => {
						next()
						resetAutoPlay()
					})

				// 绑定指示器事件
				// dots.forEach((dot, index) => {
				//	dot.addEventListener('click', () => {
				//		updateCarousel(index)
				//		resetAutoPlay()
				//	})
				// })

				// 触摸/鼠标拖拽支持
				const container = track.parentElement

				container.addEventListener('mousedown', e => {
					isDragging = true
					startX = e.pageX - container.offsetLeft
					scrollLeft = currentIndex * getCardWidth()
					track.style.cursor = 'grabbing'
				})

				container.addEventListener('mouseleave', () => {
					isDragging = false
					track.style.cursor = 'grab'
				})

				container.addEventListener('mouseup', () => {
					isDragging = false
					track.style.cursor = 'grab'
					// 松开时确保停在有效范围内
					updateCarousel(currentIndex)
				})

				container.addEventListener('mousemove', e => {
					if (!isDragging) return
					e.preventDefault()
					const x = e.pageX - container.offsetLeft
					const walk = (x - startX) * 2
					const cardWidth = getCardWidth()
					const newIndex = Math.round((scrollLeft - walk) / cardWidth)
					// 限制索引范围在 0 到 maxIndex 之间
					const clampedIndex = Math.max(0, Math.min(newIndex, maxIndex))
					updateCarousel(clampedIndex, false)
				})

				// 自动轮播（循环）
				function startAutoPlay() {
					autoPlayInterval = setInterval(() => {
						next()
					}, 5000)
				}

				function resetAutoPlay() {
					clearInterval(autoPlayInterval)
					startAutoPlay()
				}

				// 鼠标悬停时暂停（自动轮播已禁用）
				// container.addEventListener('mouseenter', () => clearInterval(autoPlayInterval));
				// container.addEventListener('mouseleave', startAutoPlay);

				// 窗口大小改变时重新计算
				window.addEventListener('resize', () => {
					const newVisibleCards = getVisibleCards()
					if (newVisibleCards !== VISIBLE_CARDS) {
						VISIBLE_CARDS = newVisibleCards
						maxIndex = Math.max(0, totalCards - VISIBLE_CARDS)
						if (currentIndex > maxIndex) {
							currentIndex = maxIndex
						}
					}
					updateCarousel(currentIndex)
				})

				// 初始化
				updateCarousel(0)
			}

			document.addEventListener('DOMContentLoaded', initCapabilityCarousel)
			// 业务场景 Tab 切换功能
			function initBusinessSceneTabs() {
				const tabs = document.querySelectorAll('.scene-tab')
				const contents = document.querySelectorAll('.scene-content')

				if (tabs.length === 0 || contents.length === 0) return

				function switchTab(index) {
					// 更新 Tab 样式
					tabs.forEach((tab, i) => {
						if (i === index) {
							tab.classList.remove('text-slate-500', 'hover:text-slate-700')
							tab.classList.add('text-azure-600', 'bg-azure-50')
						} else {
							tab.classList.remove('text-azure-600', 'bg-azure-50')
							tab.classList.add('text-slate-500', 'hover:text-slate-700')
						}
					})

					// 切换内容显示
					contents.forEach((content, i) => {
						if (i === index) {
							content.classList.remove('hidden')
							content.style.opacity = '0'
							content.style.transform = 'translateY(10px)'
							content.style.transition = 'opacity 0.3s ease, transform 0.3s ease'

							requestAnimationFrame(() => {
								content.style.opacity = '1'
								content.style.transform = 'translateY(0)'
							})
						} else {
							content.classList.add('hidden')
						}
					})
				}

				// Tab 点击事件
				tabs.forEach((tab, index) => {
					tab.addEventListener('click', () => {
						switchTab(index)
					})
				})
			}

			document.addEventListener('DOMContentLoaded', initBusinessSceneTabs)
		</script>

