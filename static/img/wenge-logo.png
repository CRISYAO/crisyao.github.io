			let currentFilter = 'paper'
			let displayedCount = 3

			function renderResearchList() {
				const container = document.getElementById('researchList')
				if (!container) return

				const filteredItems =
					currentFilter === 'all'
						? allResearchItems
						: allResearchItems.filter(item => item.category === currentFilter)

				const itemsToShow = filteredItems.slice(0, displayedCount)

				container.innerHTML = itemsToShow
					.map((item, index) => {
						// 获取跳转URL - 优先使用url字段
						const jumpUrl = item.url || '#'
						const hasUrl = item.url && item.url !== '#'
						const isExternal = hasUrl && item.url.startsWith('http')

						// 处理图片路径
						let thumbnailUrl =
							item.thumbnail ||
							item.image ||
							'https://zmt.wengegroup.com/cityMini/site/static/wenge/assets/images/doma.png'

						// 科研项目不显示封面图
						const isProject = item.category === 'project'

						return `
	                <div class="research-item flex flex-row items-start gap-5 p-5 rounded-xl border border-slate-100 hover:border-slate-200 bg-white transition-all duration-300 cursor-pointer ${hasUrl ? 'hover:bg-slate-50' : ''}" data-category="${item.category}" data-index="${index}" data-url="${item.url || ''}">
	                    ${
												!isProject
													? `
	                    <div class="w-40 h-52 flex-shrink-0 bg-slate-100 rounded-lg flex items-center justify-center overflow-hidden">
	                        <img src="${thumbnailUrl}" alt="缩略图" class="w-full h-full">
	                    </div>
	                    `
													: ''
											}
	                    <div class="${isProject ? 'w-full' : 'flex-1'} min-w-0">
	                        <div class="flex items-center gap-2 mb-2">
	                            ${item.source ? `<span class="text-xs text-slate-500">${item.source}</span>` : ''}
	                        </div>
	                        <h4 class="text-base font-semibold text-slate-900 mb-2 hover:text-indigo-600 transition-colors leading-snug">${item.title}</h4>
	                        <p class="text-sm text-slate-500 leading-relaxed line-clamp-2">${item.desc}</p>
	                    </div>
	                </div>
	            `
					})
					.join('')

				// 添加点击事件
				const items = container.querySelectorAll('.research-item')
				items.forEach(item => {
					item.addEventListener('click', () => {
						const url = item.dataset.url
						if (url) {
							window.open(url, '_blank')
						}
					})
				})

				const loadMoreBtn = document.getElementById('loadMoreBtn')
				if (loadMoreBtn) {
					if (displayedCount >= filteredItems.length) {
						loadMoreBtn.classList.add('hidden')
					} else {
						loadMoreBtn.classList.remove('hidden')
					}
				}
			}

			document.addEventListener('DOMContentLoaded', function () {
				// 筛选按钮事件
				const filterBtns = document.querySelectorAll('.research-filter-btn')
				filterBtns.forEach(btn => {
					btn.addEventListener('click', () => {
						filterBtns.forEach(b => {
							b.classList.remove('active', 'text-indigo-600', 'border-indigo-600', 'font-semibold')
							b.classList.add('text-slate-600', 'border-transparent', 'font-medium')
						})
						btn.classList.add('active', 'text-indigo-600', 'border-indigo-600', 'font-semibold')
						btn.classList.remove('text-slate-600', 'border-transparent', 'font-medium')

						currentFilter = btn.dataset.filter
						displayedCount = 3
						renderResearchList()
					})
				})

				// 显示更多按钮点击事件
				const loadMoreBtn = document.getElementById('loadMoreBtn')
				if (loadMoreBtn) {
					loadMoreBtn.addEventListener('click', () => {
						displayedCount += 3
						renderResearchList()
					})
				}

				renderResearchList()
			})

			// DOMA 层展开/收起交互
			let homeResearchFilter = 'paper'
			let homeResearchDisplayedCount = 3

			function renderHomeResearchList() {
				const container = document.getElementById('researchList')
				if (!container) return

				const filteredItems = allResearchItems.filter(item => item.category === homeResearchFilter)
				const itemsToShow = filteredItems.slice(0, homeResearchDisplayedCount)

				container.innerHTML = itemsToShow
					.map((item, index) => {
						const thumbnailUrl =
							item.thumbnail ||
							item.image ||
							'https://zmt.wengegroup.com/cityMini/site/static/wenge/assets/images/doma.png'
						const isProject = item.category === 'project'

						return `
	                <div class="research-item-enhanced flex flex-row items-start gap-5 p-5 rounded-xl border border-slate-100 hover:border-slate-200 hover:bg-slate-50 bg-white transition-all duration-300 ${isProject ? '' : 'cursor-pointer'}" data-category="${item.category}" data-index="${index}" data-url="${item.url || ''}">
	                    ${
												!isProject
													? `
	                    <div class="w-40 h-52 flex-shrink-0 bg-slate-100 rounded-lg flex items-center justify-center overflow-hidden mt-1">
	                        <img src="${thumbnailUrl}" alt="thumbnail" class="w-full h-full">
	                    </div>
	                    `
													: ''
											}
	                    <div class="${isProject ? 'w-full' : 'flex-1'} min-w-0">
	                        <div class="flex flex-wrap items-center gap-3 mb-3">
	                            ${item.source ? `<span class="text-sm text-slate-400">${item.source}</span>` : ''}
	                        </div>
	                        <h4 class="text-base font-semibold text-slate-900 mb-2 hover:text-indigo-600 transition-colors leading-snug">${item.title}</h4>
	                        <p class="text-sm text-slate-500 leading-relaxed home-research-desc transition-all duration-300">${item.desc}</p>
	                    </div>
	                </div>
	            `
					})
					.join('')

				const items = container.querySelectorAll('.research-item-enhanced')
				items.forEach(item => {
					item.addEventListener('click', event => {
						event.stopPropagation()

						const url = item.dataset.url
						if (url) {
							window.open(url, '_blank')
							return
						}

						const desc = item.querySelector('.home-research-desc')
						if (!desc) return

						const isExpanded = desc.classList.contains('expanded')
						items.forEach(otherItem => {
							if (otherItem !== item) {
								otherItem
									.querySelector('.home-research-desc')
									?.classList.remove('expanded', 'whitespace-normal', 'break-words')
							}
						})

						if (isExpanded) {
							desc.classList.remove('expanded', 'whitespace-normal', 'break-words')
						} else {
							desc.classList.add('expanded', 'whitespace-normal', 'break-words')
						}
					})
				})

				const loadMoreBtn = document.getElementById('researchLoadMoreBtn')
				if (loadMoreBtn) {
					if (homeResearchDisplayedCount >= filteredItems.length) {
						loadMoreBtn.classList.add('hidden')
					} else {
						loadMoreBtn.classList.remove('hidden')
					}
				}

				lucide.createIcons()
			}

			document.addEventListener('DOMContentLoaded', function () {
				const filterBtns = document.querySelectorAll('.research-filter-btn')
				filterBtns.forEach(btn => {
					btn.addEventListener('click', () => {
						filterBtns.forEach(button => {
							button.classList.remove(
								'active',
								'text-indigo-600',
								'border-indigo-600',
								'bg-slate-50/80',
								'font-semibold'
							)
							button.classList.add('text-slate-600', 'border-transparent', 'font-medium')
						})

						btn.classList.add(
							'active',
							'text-indigo-600',
							'border-indigo-600',
							'bg-slate-50/80',
							'font-semibold'
						)
						btn.classList.remove('text-slate-600', 'border-transparent', 'font-medium')

						homeResearchFilter = btn.dataset.filter
						homeResearchDisplayedCount = 3
						renderHomeResearchList()
					})
				})

				const loadMoreBtn = document.getElementById('researchLoadMoreBtn')
				if (loadMoreBtn) {
					loadMoreBtn.addEventListener('click', () => {
						homeResearchDisplayedCount += 3
						renderHomeResearchList()
					})
				}

				renderHomeResearchList()
			})

			document.querySelectorAll('.doma-layer').forEach(layer => {
				const header = layer.querySelector('.layer-header')
				const content = layer.querySelector('.layer-content')
				const arrow = layer.querySelector('.layer-arrow')

				header.addEventListener('click', () => {
					const isOpen = !content.classList.contains('hidden')

					// 关闭其他层
					document.querySelectorAll('.doma-layer').forEach(otherLayer => {
						if (otherLayer !== layer) {
							otherLayer.querySelector('.layer-content').classList.add('hidden')
							otherLayer.querySelector('.layer-arrow').style.transform = 'rotate(0deg)'
							otherLayer.classList.remove('ring-2', 'ring-azure-300')
						}
					})

					// 切换当前层
					if (isOpen) {
						content.classList.add('hidden')
						arrow.style.transform = 'rotate(0deg)'
						layer.classList.remove('ring-2', 'ring-azure-300')
					} else {
						content.classList.remove('hidden')
						arrow.style.transform = 'rotate(180deg)'
						layer.classList.add('ring-2', 'ring-azure-300')
					}
				})
			})

			// 业务场景 Tab 切换交互
			function initSceneTabs() {
				const tabs = document.querySelectorAll('.scene-tab')
				const contents = document.querySelectorAll('.scene-content')

				if (tabs.length === 0 || contents.length === 0) return

				tabs.forEach(tab => {
					tab.addEventListener('click', () => {
						const index = tab.dataset.index

						// 更新 Tab 样式
						tabs.forEach(t => {
							t.classList.remove('text-azure-600', 'bg-azure-50', 'shadow-sm')
							t.classList.add('text-slate-500', 'hover:text-slate-700', 'hover:bg-slate-50')
						})
						tab.classList.remove('text-slate-500', 'hover:text-slate-700', 'hover:bg-slate-50')
						tab.classList.add('text-azure-600', 'bg-azure-50', 'shadow-sm')

						// 切换内容显示
						contents.forEach(content => {
							if (content.dataset.index === index) {
								content.classList.remove('hidden')
								// 添加淡入动画
								content.style.opacity = '0'
								content.style.transform = 'translateY(10px)'
								content.style.transition = 'opacity 0.3s ease, transform 0.3s ease'
								setTimeout(() => {
									content.style.opacity = '1'
									content.style.transform = 'translateY(0)'
								}, 10)
							} else {
								content.classList.add('hidden')
							}
						})
					})
				})
			}

			// 初始化业务场景 Tab
			initSceneTabs()
		</script>
		<script>
			window.addEventListener('message', event => {
				const { data } = event

				if (data?.type !== 'doma:layer-click') return
				if (data?.action !== 'navigate' || !data?.targetUrl) return

				const popup = window.open(data.targetUrl, '_blank', 'noopener,noreferrer')
				if (popup) popup.opener = null
			})
		</script>
		<script>
			// 视频播放器弹窗功能
			const videoModal = document.getElementById('video-modal')
			const videoOverlay = document.getElementById('video-overlay')
			const closeVideoModal = document.getElementById('close-video-modal')
			const videoPlayer = document.getElementById('video-player')
			let hlsInstance = null

			function openVideoModal(videoUrl) {
				if (!videoModal) return

				videoModal.classList.remove('hidden')
				document.body.style.overflow = 'hidden'

				// 如果已有HLS实例，先销毁
				if (hlsInstance) {
					hlsInstance.destroy()
					hlsInstance = null
				}

				// 根据视频类型选择播放方式
				if (videoUrl.includes('.m3u8')) {
					if (Hls.isSupported()) {
						hlsInstance = new Hls()
						hlsInstance.loadSource(videoUrl)
						hlsInstance.attachMedia(videoPlayer)
						hlsInstance.on(Hls.Events.ERROR, function (event, data) {
							if (data.fatal) {
								console.error('HLS fatal error:', data)
								switch (data.type) {
									case Hls.ErrorTypes.NETWORK_ERROR:
										hlsInstance.startLoad()
										break
									case Hls.ErrorTypes.MEDIA_ERROR:
										hlsInstance.recoverMediaError()
										break
									default:
										hlsInstance.destroy()
										break
								}
							}
						})
					} else if (videoPlayer.canPlayType('application/vnd.apple.mpegurl')) {
						// Safari原生支持HLS
						videoPlayer.src = videoUrl
					}
				} else {
					videoPlayer.src = videoUrl
				}

				videoPlayer.play().catch(e => console.log('Auto-play prevented:', e))
			}

			function closeModal() {
				if (!videoModal) return

				videoModal.classList.add('hidden')
				document.body.style.overflow = ''

				// 停止播放并销毁HLS实例
				if (videoPlayer) {
					videoPlayer.pause()
					videoPlayer.src = ''
				}
				if (hlsInstance) {
					hlsInstance.destroy()
					hlsInstance = null
				}
			}

			// 绑定视频卡片点击事件
			document.querySelectorAll('.video-card').forEach(card => {
				card.addEventListener('click', () => {
					const videoUrl = card.getAttribute('data-video-url')
					if (videoUrl) {
						openVideoModal(videoUrl)
					}
				})
			})

			// 关闭按钮点击事件
			if (closeVideoModal) {
				closeVideoModal.addEventListener('click', closeModal)
			}

			// 蒙层点击关闭
			if (videoOverlay) {
				videoOverlay.addEventListener('click', closeModal)
			}

			// ESC键关闭弹窗
			document.addEventListener('keydown', e => {
				if (e.key === 'Escape' && videoModal && !videoModal.classList.contains('hidden')) {
					closeModal()
				}
			})
		</script>
        <script>
            class NeuralParticleNetworkNew {
                constructor(canvas) {
                    this.canvas = canvas;
                    this.ctx = canvas.getContext('2d');
                    this.heroSection = canvas ? canvas.closest('.hero-section') : null;
                    this.isActive = this.heroSection
                        ? this.heroSection.classList.contains('hero-section--active')
                        : true;
                    this.rafId = 0;
                    this.particles = [];
                    this.mouse = { x: null, y: null, radius: 200 };
                    this.corePoints = [];
                    this.flowParticles = [];
                    this.stars = [];
                    this.time = 0;
        
                    this.resize();
                    this.initCorePoints();
                    this.initParticles();
                    this.initStars();
                    this.initFlowParticles();
                    this.start();
        
                    window.addEventListener('resize', () => {
                        this.resize();
                        this.initCorePoints();
                        this.initParticles();
                        this.initStars();
                        this.initFlowParticles();
                    });
        
                    window.addEventListener('mousemove', (e) => {
                        this.mouse.x = e.clientX;
                        this.mouse.y = e.clientY;
                    });

                    document.addEventListener('hero:slidechange', (e) => {
                        const activeSection = e && e.detail ? e.detail.section : null;
                        this.setActive(activeSection === this.heroSection);
                    });

                    document.addEventListener('visibilitychange', () => {
                        if (document.hidden) {
                            this.stop();
                        } else if (this.isActive) {
                            this.start();
                        }
                    });
                }

                start() {
                    if (this.rafId || !this.isActive || document.hidden) return;
                    this.rafId = requestAnimationFrame(() => this.animate());
                }

                stop() {
                    if (this.rafId) {
                        cancelAnimationFrame(this.rafId);
                        this.rafId = 0;
                    }
                }

                setActive(nextActive) {
                    this.isActive = !!nextActive;
                    if (this.isActive) this.start();
                    else this.stop();
                }
        
                resize() {
                    this.canvas.width = window.innerWidth;
                    this.canvas.height = window.innerHeight;
                }
        
                initCorePoints() {
                    const isMobile = window.innerWidth < 768;
                    const isTablet = window.innerWidth < 1200;
        
                    const centerX = isMobile ? this.canvas.width * 0.5 :
                                    isTablet ? this.canvas.width * 0.6 : this.canvas.width * 0.7;
                    const centerY = this.canvas.height * 0.5;
        
                    const radiusMultiplier = isMobile ? 0.7 : isTablet ? 0.6 : 1;
        
                    const layers = [
                        { radius: 120 * radiusMultiplier, count: 4, name: 'input', zScale: 0.6, brightness: 1.0 },
                        { radius: 220 * radiusMultiplier, count: isMobile ? 4 : 8, name: 'hidden1', zScale: 0.8, brightness: 0.9 },
                        { radius: 340 * radiusMultiplier, count: isMobile ? 6 : 12, name: 'hidden2', zScale: 1.0, brightness: 0.7 },
                        { radius: 480 * radiusMultiplier, count: isMobile ? 8 : 16, name: 'output', zScale: 1.2, brightness: 0.5 }
                    ];
        
                    this.corePoints = [];
        
                    layers.forEach((layer, layerIndex) => {
                        for (let i = 0; i < layer.count; i++) {
                            const angle = (i / layer.count) * Math.PI * 2 + (layerIndex % 2) * 0.3;
                            const x = centerX + Math.cos(angle) * layer.radius;
                            const y = centerY + Math.sin(angle) * layer.radius;
        
                            this.corePoints.push({
                                baseX: x,
                                baseY: y,
                                x,
                                y,
                                angle: angle,
                                orbitRadius: layer.radius,
                                layer: layerIndex,
                                layerConfig: layer,
                                orbitSpeed: 0.0003 + layerIndex * 0.0001,
                                pulsePhase: Math.random() * Math.PI * 2,
                                pulseSpeed: 0.03 + Math.random() * 0.02,
                                size: layerIndex === 0 || layerIndex === layers.length - 1 ? 6 : 4,
                                zOffset: (Math.random() - 0.5) * 30
                            });
                        }
                    });
                }
        
                initParticles() {
                    const isMobile = window.innerWidth < 768;
                    const particleCount = isMobile ? 30 : Math.min(Math.floor(window.innerWidth / 20), 100);
                    this.particles = [];
        
                    for (let i = 0; i < particleCount; i++) {
                        this.particles.push({
                            x: Math.random() * this.canvas.width,
                            y: Math.random() * this.canvas.height,
                            vx: (Math.random() - 0.5) * 0.5,
                            vy: (Math.random() - 0.5) * 0.5,
                            size: Math.random() * 2 + 0.5,
                            opacity: Math.random() * 0.4 + 0.1,
                            trail: []
                        });
                    }
                }
        
                initStars() {
                    const isMobile = window.innerWidth < 768;
                    const starCount = isMobile ? 40 : Math.min(Math.floor(window.innerWidth / 10), 150);
                    this.stars = [];
        
                    for (let i = 0; i < starCount; i++) {
                        this.stars.push({
                            x: Math.random() * this.canvas.width,
                            y: Math.random() * this.canvas.height,
                            size: Math.random() * 1.5 + 0.3,
                            twinklePhase: Math.random() * Math.PI * 2,
                            twinkleSpeed: 0.02 + Math.random() * 0.03
                        });
                    }
                }
        
                initFlowParticles() {
                    const isMobile = window.innerWidth < 768;
                    const flowCount = isMobile ? 15 : 30;
                    this.flowParticles = [];
                    for (let i = 0; i < flowCount; i++) {
                        this.flowParticles.push({
                            progress: Math.random(),
                            speed: 0.005 + Math.random() * 0.01,
                            fromNode: null,
                            toNode: null,
                            size: Math.random() * 2 + 1,
                            opacity: Math.random() * 0.5 + 0.3
                        });
                    }
                }
        
                animate() {
                    if (!this.isActive || document.hidden) {
                        this.rafId = 0;
                        return;
                    }
                    this.time += 0.016;
                    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        
                    this.ctx.fillStyle = 'rgba(2, 6, 23, 0.1)';
                    this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
        
                    this.stars.forEach(star => {
                        star.twinklePhase += star.twinkleSpeed;
                        const twinkle = Math.sin(star.twinklePhase) * 0.5 + 0.5;
        
                        this.ctx.beginPath();
                        this.ctx.arc(star.x, star.y, star.size * twinkle, 0, Math.PI * 2);
                        this.ctx.fillStyle = `rgba(147, 197, 253, ${twinkle * 0.6})`;
                        this.ctx.fill();
                    });
        
                    const isMobile = window.innerWidth < 768;
                    const isTablet = window.innerWidth < 1200;
                    const centerX = isMobile ? this.canvas.width * 0.5 :
                                    isTablet ? this.canvas.width * 0.6 : this.canvas.width * 0.7;
                    const centerY = this.canvas.height * 0.5;
        
                    this.corePoints.forEach((p) => {
                        p.x = p.baseX;
                        p.y = p.baseY;
                        const pulse = 0.5;
                        const zScale = p.layerConfig.zScale;
                        const brightness = p.layerConfig.brightness;
                        const baseSize = (p.layer === 0 || p.layer === 3) ? 6 : 4;
        
                        const outerGlowSize = baseSize * (3 + zScale * 3);
                        const outerGlow = this.ctx.createRadialGradient(
                            p.x, p.y, 0,
                            p.x, p.y, outerGlowSize
                        );
                        outerGlow.addColorStop(0, `rgba(59, 130, 246, ${0.3 * pulse * brightness})`);
                        outerGlow.addColorStop(0.3, `rgba(59, 130, 246, ${0.15 * pulse * brightness})`);
                        outerGlow.addColorStop(1, 'transparent');
                        this.ctx.beginPath();
                        this.ctx.arc(p.x, p.y, outerGlowSize, 0, Math.PI * 2);
                        this.ctx.fillStyle = outerGlow;
                        this.ctx.fill();
        
                        const midGlowSize = baseSize * (1.5 + zScale * 1.5);
                        const midGlow = this.ctx.createRadialGradient(
                            p.x, p.y, 0,
                            p.x, p.y, midGlowSize
                        );
                        midGlow.addColorStop(0, `rgba(96, 165, 250, ${0.5 * pulse * brightness})`);
                        midGlow.addColorStop(1, 'transparent');
                        this.ctx.beginPath();
                        this.ctx.arc(p.x, p.y, midGlowSize, 0, Math.PI * 2);
                        this.ctx.fillStyle = midGlow;
                        this.ctx.fill();
        
                        this.ctx.beginPath();
                        this.ctx.arc(p.x, p.y, baseSize * 0.8, 0, Math.PI * 2);
                        this.ctx.fillStyle = `rgba(147, 197, 253, ${0.8 * brightness})`;
                        this.ctx.fill();
        
                        this.ctx.beginPath();
                        this.ctx.arc(p.x - baseSize * 0.2, p.y - baseSize * 0.2, baseSize * 0.25, 0, Math.PI * 2);
                        this.ctx.fillStyle = `rgba(255, 255, 255, ${0.5 * brightness})`;
                        this.ctx.fill();
                    });
        
                    for (let i = 0; i < this.corePoints.length; i++) {
                        for (let j = i + 1; j < this.corePoints.length; j++) {
                            const p1 = this.corePoints[i];
                            const p2 = this.corePoints[j];
                            const dx = p1.x - p2.x;
                            const dy = p1.y - p2.y;
                            const dist = Math.sqrt(dx * dx + dy * dy);
        
                            const layerDiff = Math.abs(p1.layer - p2.layer);
        
                            if (layerDiff === 1 && dist < 250) {
                                const zScale1 = p1.layerConfig.zScale;
                                const zScale2 = p2.layerConfig.zScale;
                                const avgZScale = (zScale1 + zScale2) / 2;
                                const opacity = (1 - dist / 250) * 0.3 * avgZScale;
        
                                this.ctx.beginPath();
                                this.ctx.moveTo(p1.x, p1.y);
                                this.ctx.lineTo(p2.x, p2.y);
                                this.ctx.strokeStyle = `rgba(59, 130, 246, ${opacity})`;
                                this.ctx.lineWidth = 1.2 * avgZScale;
                                this.ctx.stroke();
                            }
                        }
                    }
        
                    this.particles.forEach(p => {
                        p.trail.unshift({ x: p.x, y: p.y });
                        if (p.trail.length > 5) p.trail.pop();
        
                        p.x += p.vx;
                        p.y += p.vy;
        
                        if (p.x < 0 || p.x > this.canvas.width) p.vx *= -1;
                        if (p.y < 0 || p.y > this.canvas.height) p.vy *= -1;
        
                        const dx = this.mouse.x - p.x;
                        const dy = this.mouse.y - p.y;
                        const dist = Math.sqrt(dx * dx + dy * dy);
        
                        if (dist < this.mouse.radius) {
                            const force = (this.mouse.radius - dist) / this.mouse.radius;
                            p.x -= dx * force * 0.03;
                            p.y -= dy * force * 0.03;
                        }
        
                        p.trail.forEach((t, idx) => {
                            const trailOpacity = (1 - idx / p.trail.length) * 0.2;
                            this.ctx.beginPath();
                            this.ctx.arc(t.x, t.y, p.size * (1 - idx / p.trail.length), 0, Math.PI * 2);
                            this.ctx.fillStyle = `rgba(59, 130, 246, ${trailOpacity})`;
                            this.ctx.fill();
                        });
        
                        let connected = false;
                        this.corePoints.forEach(cp => {
                            const dx = cp.x - p.x;
                            const dy = cp.y - p.y;
                            const dist = Math.sqrt(dx * dx + dy * dy);
                            if (dist < 150) {
                                connected = true;
                                this.ctx.beginPath();
                                this.ctx.moveTo(p.x, p.y);
                                this.ctx.lineTo(cp.x, cp.y);
                                const opacity = (1 - dist / 150) * 0.08;
                                this.ctx.strokeStyle = `rgba(147, 197, 253, ${opacity})`;
                                this.ctx.lineWidth = 0.5;
                                this.ctx.stroke();
                            }
                        });
        
                        this.ctx.beginPath();
                        this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                        this.ctx.fillStyle = connected
                            ? `rgba(147, 197, 253, ${p.opacity + 0.2})`
                            : `rgba(59, 130, 246, ${p.opacity})`;
                        this.ctx.fill();
                    });
        
                    this.rafId = requestAnimationFrame(() => this.animate());
                }
            }
        
            class HeroAnimationNew {
                constructor() {
                    this.init();
                }
        
                init() {
                    gsap.to('.hero-title-group', {
                        opacity: 1,
                        y: 0,
                        duration: 1,
                        ease: 'power3.out'
                    });
        
                    gsap.to('.hero-subtitle-group', {
                        opacity: 1,
                        y: 0,
                        duration: 1,
                        ease: 'power3.out',
                        delay: 0.2
                    });
        
                    gsap.to('.hero-features', {
                        opacity: 1,
                        y: 0,
                        duration: 1,
                        ease: 'power3.out',
                        delay: 0.4
                    });
        
                    gsap.to('.hero-cta', {
                        opacity: 1,
                        y: 0,
                        duration: 1,
                        ease: 'power3.out',
                        delay: 0.6
                    });
        
                    gsap.to('.scroll-indicator', {
                        opacity: 1,
                        duration: 0.6,
                        delay: 1
                    });
        
                    gsap.to('.scroll-mouse::before', {
                        y: 10,
                        duration: 1,
                        repeat: -1,
                        yoyo: true,
                        ease: 'power1.inOut'
                    });
                }
            }
        
            document.addEventListener('DOMContentLoaded', () => {
                const canvas = document.getElementById('particles-canvas');
                new NeuralParticleNetworkNew(canvas);
                new HeroAnimationNew();
            });
        </script>

<script>
	// 初始化 Lucide 图标
	lucide.createIcons();

	// 复杂的本体网络画布背景特效 (Canvas Animation)
	document.addEventListener('DOMContentLoaded', function () {
		const canvas = document.getElementById('hero-canvas');
		if (!canvas) return;
		const heroSection = canvas.closest('.hero-section');

		const ctx = canvas.getContext('2d');
		let width, height;
		let networkYMax;

		let cores = [];
		let dataNodes = [];
		let streams = [];
		let ripples = [];

		let animationFrameId;
		let isActive = heroSection ? heroSection.classList.contains('hero-section--active') : true;

		// 鼠标交互点
		let mouse = { x: -1000, y: -1000, radius: 250 };

		canvas.addEventListener('mousemove', (e) => {
			const rect = canvas.getBoundingClientRect();
			mouse.x = e.clientX - rect.left;
			mouse.y = e.clientY - rect.top;
		});

		canvas.addEventListener('mouseleave', () => {
			mouse.x = -1000;
			mouse.y = -1000;
		});

		function resizeCanvas () {
			const pixelRatio = window.devicePixelRatio || 1;
			const w = canvas.offsetWidth;
			const h = canvas.offsetHeight;
			canvas.width = w * pixelRatio;
			canvas.height = h * pixelRatio;
			ctx.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
			width = w;
			height = h;
			
			// 将网络分布的边界扩大到全屏高度，以覆盖底部网格
			networkYMax = height; 
			initOntologyNetwork();
		}

		// 绘制六边形(数据节点外观)
		function drawHexagon (x, y, size) {
			ctx.beginPath();
			for (let i = 0; i < 6; i++) {
				const angle = (Math.PI / 3) * i - Math.PI / 6;
				const hx = x + size * Math.cos(angle);
				const hy = y + size * Math.sin(angle);
				if (i === 0) ctx.moveTo(hx, hy);
				else ctx.lineTo(hx, hy);
			}
			ctx.closePath();
		}

		// 核心节点 (CoreNode)
		class CoreNode {
			constructor(x, y) {
				const padX = 100;
				this.x = x || Math.random() * Math.max(40, width - 2 * padX) + padX;
				const yTop = 50;
				const yBottom = networkYMax - 50;
				this.y = y || (yTop + Math.pow(Math.random(), 1.55) * (yBottom - yTop));
				this.vx = (Math.random() - 0.5) * 0.3;
				this.vy = (Math.random() - 0.5) * 0.3;
				this.radius = Math.random() * 8 + 12;
				this.rotation = Math.random() * Math.PI * 2;
				this.rotationSpeed = (Math.random() - 0.5) * 0.02;
				this.links = [];
			}

			update () {
				if (this.x < 50 || this.x > width - 50) this.vx *= -1;
				if (this.y < 50 || this.y > networkYMax - 50) this.vy *= -1;
				this.x += this.vx;
				this.y += this.vy;
				this.y = Math.min(Math.max(this.y, 50), networkYMax - 50);
				this.rotation += this.rotationSpeed;
			}

			draw () {
				ctx.save();
				ctx.translate(this.x, this.y);

				// 内核
				ctx.beginPath();
				ctx.arc(0, 0, this.radius * 0.6, 0, Math.PI * 2);
				ctx.fillStyle = 'rgba(29, 78, 216, 0.9)';
				ctx.shadowBlur = 20;
				ctx.shadowColor = 'rgba(59, 130, 246, 1)';
				ctx.fill();
				ctx.shadowBlur = 0;

				// 旋转外圈
				ctx.rotate(this.rotation);
				ctx.beginPath();
				ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
				ctx.strokeStyle = 'rgba(6, 182, 212, 0.8)';
				ctx.lineWidth = 1.5;
				ctx.setLineDash([this.radius * 0.8, this.radius * 0.4]);
				ctx.stroke();
				ctx.setLineDash([]);

				// 最外层虚线轨道
				ctx.rotate(-this.rotation * 2);
				ctx.beginPath();
				ctx.arc(0, 0, this.radius * 1.3, 0, Math.PI * 2);
				ctx.strokeStyle = 'rgba(37, 99, 235, 0.3)';
				ctx.lineWidth = 1;
				ctx.setLineDash([4, 6]);
				ctx.stroke();
				ctx.setLineDash([]);

				ctx.restore();
			}
		}

		// 卫星数据节点 (DataNode)
		class DataNode {
			constructor(parentCore) {
				this.parent = parentCore;
				const angle = Math.random() * Math.PI * 2;
				const distance = Math.random() * 130 + 50;
				this.x = this.parent.x + Math.cos(angle) * distance;
				this.y = this.parent.y + Math.sin(angle) * distance;
				this.x = Math.min(Math.max(this.x, 40), width - 40);
				this.y = Math.min(Math.max(this.y, 40), networkYMax - 40);

				this.vx = (Math.random() - 0.5) * 0.8;
				this.vy = (Math.random() - 0.5) * 0.8;
				this.size = Math.random() * 2 + 2;
				this.orbitAngle = angle;
				this.orbitSpeed = (Math.random() - 0.5) * 0.005;
			}

			update () {
				this.orbitAngle += this.orbitSpeed;
				const orbitR = 95;
				const targetX = this.parent.x + Math.cos(this.orbitAngle) * orbitR;
				let targetY = this.parent.y + Math.sin(this.orbitAngle) * orbitR;
				targetY = Math.min(targetY, networkYMax - 20);

				this.vx += (targetX - this.x) * 0.001;
				this.vy += (targetY - this.y) * 0.001;

				this.vx *= 0.98;
				this.vy *= 0.98;

				// 鼠标排斥力
				let dx = mouse.x - this.x;
				let dy = mouse.y - this.y;
				let dist = Math.sqrt(dx * dx + dy * dy);
				if (dist < mouse.radius) {
					let force = (mouse.radius - dist) / mouse.radius;
					this.vx -= (dx / dist) * force * 1.5;
					this.vy -= (dy / dist) * force * 1.5;
				}

				if (this.y > networkYMax - 5) {
					this.vy -= 0.06;
				}

				this.x += this.vx;
				this.y += this.vy;
				this.y = Math.min(this.y, networkYMax - 10);
				this.x = Math.min(Math.max(this.x, 30), width - 30);
			}

			draw () {
				drawHexagon(this.x, this.y, this.size);
				ctx.fillStyle = 'rgba(59, 130, 246, 0.6)';
				ctx.fill();
				ctx.strokeStyle = 'rgba(147, 197, 253, 0.5)';
				ctx.lineWidth = 0.5;
				ctx.stroke();
			}
		}

		// 流动数据线 (DataStream)
		class DataStream {
			constructor(p1, p2, type) {
				this.p1 = p1;
				this.p2 = p2;
				this.progress = 0;
				this.isCoreLevel = type === 'core2core';
				this.speed = this.isCoreLevel ? (Math.random() * 0.008 + 0.005) : (Math.random() * 0.015 + 0.01);
				this.length = this.isCoreLevel ? 0.2 : 0.1;
			}

			update () {
				this.progress += this.speed;
				return this.progress >= 1;
			}

			draw () {
				let startProg = Math.max(0, this.progress - this.length);
				let x1 = this.p1.x + (this.p2.x - this.p1.x) * startProg;
				let y1 = this.p1.y + (this.p2.y - this.p1.y) * startProg;
				let x2 = this.p1.x + (this.p2.x - this.p1.x) * this.progress;
				let y2 = this.p1.y + (this.p2.y - this.p1.y) * this.progress;

				let gradient = ctx.createLinearGradient(x1, y1, x2, y2);
				gradient.addColorStop(0, 'rgba(6, 182, 212, 0)');
				gradient.addColorStop(1, this.isCoreLevel ? 'rgba(6, 182, 212, 1)' : 'rgba(255, 255, 255, 1)');

				ctx.beginPath();
				ctx.moveTo(x1, y1);
				ctx.lineTo(x2, y2);
				ctx.strokeStyle = gradient;
				ctx.lineWidth = this.isCoreLevel ? 3 : 1.5;
				ctx.lineCap = 'round';

				ctx.shadowBlur = 10;
				ctx.shadowColor = 'rgba(6, 182, 212, 0.8)';
				ctx.stroke();
				ctx.shadowBlur = 0;
				ctx.lineCap = 'butt';
			}
		}

		// 激流波纹 (Ripple)
		class Ripple {
			constructor(x, y) {
				this.x = x;
				this.y = y;
				this.radius = 5;
				this.maxRadius = Math.random() * 30 + 30;
				this.opacity = 0.8;
			}
			update () {
				this.radius += 1.5;
				this.opacity -= 0.8 / (this.maxRadius / 1.5);
				return this.opacity <= 0;
			}
			draw () {
				ctx.beginPath();
				ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
				ctx.strokeStyle = `rgba(6, 182, 212, ${Math.max(0, this.opacity)})`;
				ctx.lineWidth = 1.5;
				ctx.stroke();
			}
		}

		// 初始化网络生成
		function initOntologyNetwork () {
			cores = [];
			dataNodes = [];
			streams = [];
			ripples = [];

			const coreCount = window.innerWidth > 768 ? 6 : 3;
			for (let i = 0; i < coreCount; i++) {
				cores.push(new CoreNode());
			}

			// 核心节点之间的连线
			for (let i = 0; i < cores.length; i++) {
				for (let j = i + 1; j < cores.length; j++) {
					if (Math.random() > 0.3) {
						cores[i].links.push(cores[j]);
					}
				}
			}

			// 生成卫星数据节点
			const dataDensity = window.innerWidth > 768 ? 150 : 60;
			for (let i = 0; i < dataDensity; i++) {
				let randomCore = cores[Math.floor(Math.random() * cores.length)];
				dataNodes.push(new DataNode(randomCore));
			}
		}

		// 动画主循环
		function animate () {
			if (!isActive || document.hidden) {
				animationFrameId = 0;
				return;
			}
			ctx.clearRect(0, 0, width, height);

			// 画科技感网格线
			ctx.strokeStyle = 'rgba(37, 99, 235, 0.05)';
			ctx.lineWidth = 1;
			const gridSize = 80;
			const timeOffset = (Date.now() / 60) % gridSize;
			ctx.beginPath();
			for (let x = timeOffset; x < width; x += gridSize) {
				ctx.moveTo(x, 0); ctx.lineTo(x, height);
			}
			for (let y = timeOffset; y < height; y += gridSize) {
				ctx.moveTo(0, y); ctx.lineTo(width, y);
			}
			ctx.stroke();

			// 绘制核心节点间的静态线
			ctx.lineWidth = 1.2;
			cores.forEach(core => {
				core.links.forEach(target => {
					ctx.beginPath();
					ctx.moveTo(core.x, core.y);
					ctx.lineTo(target.x, target.y);
					let dist = Math.hypot(core.x - target.x, core.y - target.y);
					let alpha = 0.3 + Math.sin(Date.now() / 500 + dist) * 0.15; // 呼吸闪烁
					ctx.strokeStyle = `rgba(37, 99, 235, ${alpha})`;
					ctx.stroke();

					// 随机产生核心级流数据
					if (Math.random() < 0.005) {
						streams.push(new DataStream(core, target, 'core2core'));
					}
				});
			});

			// 绘制卫星节点和连线
			dataNodes.forEach(node => {
				node.update();

				let distSq = Math.pow(node.x - node.parent.x, 2) + Math.pow(node.y - node.parent.y, 2);
				if (distSq < 40000) {
					let opacity = 1 - Math.sqrt(distSq) / 200;
					ctx.beginPath();
					ctx.moveTo(node.x, node.y);
					ctx.lineTo(node.parent.x, node.parent.y);
					ctx.strokeStyle = `rgba(147, 197, 253, ${opacity * 0.4})`;
					ctx.lineWidth = 0.8;
					ctx.stroke();

					// 随机产生外围级流数据
					if (Math.random() < 0.008) {
						let p1 = Math.random() > 0.5 ? node : node.parent;
						let p2 = p1 === node ? node.parent : node;
						streams.push(new DataStream(p1, p2, 'data2core'));
					}
				}
				node.draw();

				// 鼠标交互跟随光效
				let distMouse = Math.hypot(mouse.x - node.x, mouse.y - node.y);
				if (distMouse < mouse.radius * 0.8) {
					ctx.beginPath();
					ctx.moveTo(node.x, node.y);
					ctx.lineTo(mouse.x, mouse.y);
					ctx.strokeStyle = `rgba(6, 182, 212, ${(1 - distMouse / (mouse.radius * 0.8)) * 0.5})`;
					ctx.lineWidth = 0.5;
					ctx.setLineDash([2, 2]);
					ctx.stroke();
					ctx.setLineDash([]);
				}
			});

			// 更新并绘制核心节点
			cores.forEach(core => {
				core.update();
				core.draw();
			});

			// 更新绘制数据流
			streams = streams.filter(stream => {
				let isDone = stream.update();
				stream.draw();
				if (isDone) {
					if (cores.includes(stream.p2)) {
						ripples.push(new Ripple(stream.p2.x, stream.p2.y)); // 到达后产生涟漪
					}
				}
				return !isDone;
			});

			// 绘制涟漪
			ripples = ripples.filter(ripple => {
				let isDone = ripple.update();
				ripple.draw();
				return !isDone;
			});

			// 鼠标聚焦点光标圈
			if (mouse.x > 0 && mouse.y > 0) {
				ctx.save();
				ctx.translate(mouse.x, mouse.y);
				ctx.rotate(Date.now() / 1000);
				ctx.beginPath();
				ctx.arc(0, 0, 15, 0, Math.PI * 2);
				ctx.strokeStyle = 'rgba(6, 182, 212, 0.4)';
				ctx.lineWidth = 1;
				ctx.setLineDash([4, 4]);
				ctx.stroke();
				ctx.restore();
			}

			animationFrameId = requestAnimationFrame(animate);
		}

		function startAnimation() {
			if (animationFrameId || !isActive || document.hidden) return;
			animationFrameId = requestAnimationFrame(animate);
		}

		function stopAnimation() {
			if (animationFrameId) {
				cancelAnimationFrame(animationFrameId);
				animationFrameId = 0;
			}
		}

		// 自适应缩放重置
		resizeCanvas();
		window.addEventListener('resize', () => {
			stopAnimation();
			resizeCanvas();
			startAnimation();
		});
		document.addEventListener('hero:slidechange', e => {
			const activeSection = e && e.detail ? e.detail.section : null;
			isActive = activeSection === heroSection;
			mouse.x = -1000;
			mouse.y = -1000;
			if (isActive) startAnimation();
			else stopAnimation();
		});
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stopAnimation();
			else if (isActive) startAnimation();
		});
		startAnimation();
	});
</script>

		<!-- Hero轮播切换 -->
		<script>
			;(function () {
				const heroSections = document.querySelectorAll('.hero-section')
				const dots = document.querySelectorAll('.hero-dot')
				const activeClass = 'hero-section--active'
				if (heroSections.length < 2) return

				let currentIndex = 0
				let timer = null
				const interval = 5000 // 5秒

				function showHero(index) {
					currentIndex = index
					heroSections.forEach((section, i) => {
						const isActive = i === index
						if (i === index) {
							section.classList.remove('opacity-0')
							section.classList.add('opacity-100')
						} else {
							section.classList.remove('opacity-100')
							section.classList.add('opacity-0')
						}
						section.classList.toggle(activeClass, isActive)
						section.setAttribute('aria-hidden', isActive ? 'false' : 'true')
					})
					dots.forEach((dot, i) => {
						if (i === index) {
							dot.classList.remove('bg-white/30')
							dot.classList.add('bg-white', 'w-16')
						} else {
							dot.classList.remove('bg-white', 'w-16')
							dot.classList.add('bg-white/30')
						}
					})
					document.dispatchEvent(
						new CustomEvent('hero:slidechange', {
							detail: {
								index: index,
								section: heroSections[index] || null
							}
						})
					)
				}

				function startTimer() {
					clearInterval(timer)
					timer = setInterval(function () {
						showHero((currentIndex + 1) % heroSections.length)
					}, interval)
				}

				// 点击指示器切换
				dots.forEach(function (dot) {
					dot.addEventListener('click', function () {
						var idx = parseInt(this.getAttribute('data-hero-index'))
						showHero(idx)
						startTimer()
					})
				})

				// 初始化
				showHero(0)
				startTimer()
			})()
		</script>

        
<script>
    lucide.createIcons();

    /** 首屏 CTA：mousemove 更新 --x / --y，聚光灯层 opacity 由 --spotlight-opacity 平滑过渡 */
    (function initHeroCtaSpotlight() {
        var btn = document.getElementById('hero-cta-lit');
        if (!btn) return;
        var hideSpotTimer = 0;

        function setSpotFromPoint(clientX, clientY) {
            var r = btn.getBoundingClientRect();
            var w = r.width || 1;
            var h = r.height || 1;
            var xp = ((clientX - r.left) / w) * 100;
            var yp = ((clientY - r.top) / h) * 100;
            btn.style.setProperty('--x', Math.max(0, Math.min(100, xp)).toFixed(2) + '%');
            btn.style.setProperty('--y', Math.max(0, Math.min(100, yp)).toFixed(2) + '%');
        }

        function showSpotlight() {
            clearTimeout(hideSpotTimer);
            btn.style.setProperty('--spotlight-opacity', '1');
        }

        function hideSpotlight() {
            btn.style.setProperty('--spotlight-opacity', '0');
            clearTimeout(hideSpotTimer);
            hideSpotTimer = setTimeout(function () {
                btn.style.setProperty('--x', '50%');
                btn.style.setProperty('--y', '50%');
            }, 480);
        }

        btn.addEventListener('mouseenter', function (e) {
            showSpotlight();
            setSpotFromPoint(e.clientX, e.clientY);
        });
        btn.addEventListener('mousemove', function (e) {
            setSpotFromPoint(e.clientX, e.clientY);
        });
        btn.addEventListener('mouseleave', hideSpotlight);

        btn.addEventListener('focus', function () {
            showSpotlight();
            btn.style.setProperty('--x', '50%');
            btn.style.setProperty('--y', '50%');
        });
        btn.addEventListener('blur', hideSpotlight);

        btn.addEventListener(
            'touchstart',
            function (e) {
                showSpotlight();
                if (e.touches.length) setSpotFromPoint(e.touches[0].clientX, e.touches[0].clientY);
            },
            { passive: true }
        );
        btn.addEventListener(
            'touchmove',
            function (e) {
                if (e.touches.length) setSpotFromPoint(e.touches[0].clientX, e.touches[0].clientY);
            },
            { passive: true }
        );
        btn.addEventListener('touchend', hideSpotlight, { passive: true });
        btn.addEventListener('touchcancel', hideSpotlight, { passive: true });
        const savedLang = localStorage.getItem('lang')
        console.log(savedLang,'--------')
    })();

    /**
     * 首屏单 Canvas：深空 → 背景星 → 科学图案星 → 黑洞/公式图（screen 盖在星场之上；图案勿再叠在洞上，否则近黑描边呈「黑点」）。
     * 等效 GLSL「iTime * 0.005」→ *0.02：STARFIELD_TIME_SCALE = 0.02/0.005。
     */
    let stopHeroStarfield = function () {};
    (function initHeroStarfieldPoster() {
        var heroSlide = document.getElementById('hero-panshi-slide');
        var container = document.getElementById('hero-starfield-wrap');
        var canvas = document.getElementById('hero-starfield');
        if (!heroSlide || !container || !canvas) return;
        var ctx =
            canvas.getContext('2d', { alpha: false, desynchronized: true }) ||
            canvas.getContext('2d');
        if (!ctx) return;
        var blackHoleImg = new Image();
        blackHoleImg.src = 'https://zmt.wengegroup.com/cityMini/site/static/wenge/panshi/hero-video-poster.png';
        var gonngshiImg = new Image();
        gonngshiImg.src = 'https://zmt.wengegroup.com/cityMini/site/static/wenge/panshi/gonngshi.png';

        /** 随机背景星数量（其余为科学图案星；苯/五元环边加密后略减背景星） */
        var BACKDROP_STAR_COUNT = 1465;
        /** 公式图顺时针缓慢旋转（弧度/毫秒），约 2.5 分钟一圈 */
        var GONGSHI_ROTATE_RAD_PER_MS = (Math.PI * 2) / (150 * 1000);
        /** 与片元着色器 iTime 系数 0.005 → 0.02 等效（4× 星场漂移速度） */
        var STARFIELD_TIME_SCALE = 0.02 / 0.005;
        var heroStarRepelEnabled = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var patternMotifRotate = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var mouseInHero = false;
        var mouseCx = 0;
        var mouseCy = 0;

        var stars = [];
        var backdropStars = [];
        var patternStars = [];
        var rafId = 0;
        var stopped = false;
        var isActive = heroSlide.classList.contains('hero-section--active');
        var activeStarOffsets = false;
        var lastTs = 0;
        var lastRenderTs = 0;
        var bhEnterStartMs = null;
        var TARGET_FRAME_MS = 1000 / 36;
        var backdropCacheCanvas = document.createElement('canvas');
        var backdropCacheCtx = backdropCacheCanvas.getContext('2d');
        /** 黑洞/公式图入场：线性从 0 → 80% 不透明度的时长（毫秒） */
        var BH_ENTER_RAMP_MS = 1400;
        var BH_ENTER_MAX_OPACITY = 0.8;
        /** 黑洞/公式中心水平位置（0–1），略大于 0.5 则偏右，与左栏文案对齐 */
        var BH_CENTER_X_FRAC = 0.615;
        /** 在原先 contain 缩放系数 0.88 基础上整体再放大 */
        var BH_SCALE_MUL = 1.14;

        function getBackdropStarCount(w, h) {
            var area = Math.max(1, (w || 800) * (h || 600));
            var density = Math.min(1, area / 1600000);
            return Math.round(560 + density * 420);
        }

        function spawnStar(star, w, h) {
            star.x = Math.random() * w;
            star.y = Math.random() * h;
            if (Math.random() < 0.035) {
                star.size = 1.5 + Math.random() * 0.5;
            } else {
                star.size = 0.1 + Math.random() * 1.4;
            }
            star.baseOpacity = 0.18 + Math.random() * 0.82;
            star.twinklePhase = Math.random() * Math.PI * 2;
            star.twinkleSpeed = 0.00025 + Math.random() * 0.0018;
            star.speedX = -0.02 - Math.random() * 0.08;
            star.speedY = -0.02 - Math.random() * 0.08;
            star.glow = 1 + ((Math.random() * 4) | 0);
            star.ox = 0;
            star.oy = 0;
            star.isTiny = star.size <= 0.9;
            star.useGlow = !star.isTiny && (star.size > 1.18 || star.baseOpacity > 0.78);
        }

        function pushScienceMotifStars(w, h) {
            var m = Math.min(w, h);
            var pi = Math.PI;
            var rotK = 0.000034;
            var seed = 0;
            function visBase(extra) {
                seed++;
                var o = {
                    isPattern: true,
                    x: 0,
                    y: 0,
                    speedX: 0,
                    speedY: 0,
                    size: 0.12 + ((seed * 17) % 100) / 100 * 1.12,
                    baseOpacity: 0.32 + ((seed * 31) % 65) / 100,
                    twinklePhase: (seed * 0.413) % (pi * 2),
                    twinkleSpeed: 0.00028 + ((seed * 13) % 40) / 50000,
                    glow: 1 + ((seed * 5) % 4),
                    ox: 0,
                    oy: 0
                };
                if (extra) {
                    var k;
                    for (k in extra) {
                        if (Object.prototype.hasOwnProperty.call(extra, k)) o[k] = extra[k];
                    }
                }
                o.isTiny = false;
                o.useGlow = o.size > 0.72 || o.baseOpacity > 0.78;
                return o;
            }
            /* 三处图案分区：左 DNA、右上苯环、右下五元环，避免与中央黑洞叠在一起 */
            var dnaCxN = 0.14;
            var dnaY0N = 0.16;
            var dnaHN = 0.42;
            var dnaRN = 0.11;
            var helixTiltRad = -0.1 - Math.random() * 0.08;
            var dnaTurns = 2.85 + Math.random() * 0.45;
            var nStr = 76;
            var helixPhase = (Math.random() - 0.5) * 0.35;
            var dnaPhaseNudge = (Math.random() - 0.5) * 0.1;
            var dnaRadMul = 0.96 + Math.random() * 0.1;
            var dnaYNudge = (Math.random() - 0.5) * m * 0.006;
            var strand;
            var ti;
            var chordTs = [0.18, 0.5, 0.82];
            var ci;
            for (strand = 0; strand < 2; strand++) {
                for (ti = 0; ti < nStr; ti++) {
                    var yf = ti / Math.max(1, nStr - 1);
                    stars.push(
                        visBase({
                            motif: 'dna',
                            strand: strand,
                            ti: ti,
                            nStr: nStr,
                            dnaCxN: dnaCxN,
                            dnaY0N: dnaY0N,
                            dnaHN: dnaHN,
                            dnaRN: dnaRN,
                            dnaTurns: dnaTurns,
                            rotK: rotK * 0.45,
                            helixTiltRad: helixTiltRad,
                            helixPhase: helixPhase,
                            phaseNudge: dnaPhaseNudge,
                            radMul: dnaRadMul,
                            jx: (Math.random() - 0.5) * m * 0.012,
                            jy: (Math.random() - 0.5) * m * 0.01,
                            yNudge: dnaYNudge,
                            size: 0.38 + Math.random() * 0.55,
                            baseOpacity: 0.7 + Math.random() * 0.24,
                            glow: 2 + ((Math.random() * 2) | 0)
                        })
                    );
                }
            }
            for (ti = 0; ti < nStr; ti += 3) {
                for (ci = 0; ci < chordTs.length; ci++) {
                    stars.push(
                        visBase({
                            motif: 'dnaRung',
                            ti: ti,
                            chordT: chordTs[ci],
                            tiFrac: ti / Math.max(1, nStr - 1),
                            nStr: nStr,
                            dnaCxN: dnaCxN,
                            dnaY0N: dnaY0N,
                            dnaHN: dnaHN,
                            dnaRN: dnaRN,
                            dnaTurns: dnaTurns,
                            rotK: rotK * 0.45,
                            helixTiltRad: helixTiltRad,
                            helixPhase: helixPhase,
                            phaseNudge: dnaPhaseNudge,
                            radMul: dnaRadMul,
                            yNudge: dnaYNudge,
                            jx: (Math.random() - 0.5) * m * 0.008,
                            jy: (Math.random() - 0.5) * m * 0.006,
                            size: 0.2 + Math.random() * 0.32,
                            baseOpacity: 0.62 + Math.random() * 0.28,
                            glow: 1 + ((Math.random() * 2) | 0)
                        })
                    );
                }
            }
            var bzCxN = 0.78;
            var bzCyN = 0.24;
            var bzRN = 0.148;
            var bzR2N = 0.078;
            var vi;
            for (vi = 0; vi < 6; vi++) {
                stars.push(
                    visBase({
                        motif: 'benz',
                        vi: vi,
                        bzCxN: bzCxN,
                        bzCyN: bzCyN,
                        bzRN: bzRN,
                        rotK: rotK * 0.62,
                        angJ: (Math.random() - 0.5) * 0.2,
                        radJ: 1 + (Math.random() - 0.5) * 0.08,
                        jx: (Math.random() - 0.5) * m * 0.012,
                        jy: (Math.random() - 0.5) * m * 0.012,
                        size: 0.88 + Math.random() * 0.82,
                        baseOpacity: 0.86 + Math.random() * 0.14,
                        glow: 3 + ((Math.random() * 2) | 0)
                    })
                );
            }
            for (vi = 0; vi < 6; vi++) {
                stars.push(
                    visBase({
                        motif: 'benzBond',
                        vi: vi,
                        bzCxN: bzCxN,
                        bzCyN: bzCyN,
                        bzRN: bzRN,
                        bondRFrac: 0.86 + Math.random() * 0.1,
                        rotK: rotK * 0.62,
                        bondAngJ: (Math.random() - 0.5) * 0.14,
                        jx: (Math.random() - 0.5) * m * 0.008,
                        jy: (Math.random() - 0.5) * m * 0.008,
                        size: 0.42 + Math.random() * 0.46,
                        baseOpacity: 0.72 + Math.random() * 0.24,
                        glow: 2
                    })
                );
            }
            var edgeT4 = [0.22, 0.44, 0.67, 0.89];
            var tei;
            for (vi = 0; vi < 6; vi++) {
                for (tei = 0; tei < edgeT4.length; tei++) {
                    stars.push(
                        visBase({
                            motif: 'benzEdge',
                            vi: vi,
                            edgeT: edgeT4[tei],
                            bzCxN: bzCxN,
                            bzCyN: bzCyN,
                            bzRN: bzRN,
                            rotK: rotK * 0.62,
                            edgeAngJ: (Math.random() - 0.5) * 0.11,
                            radT: 0.97 + Math.random() * 0.06,
                            jx: (Math.random() - 0.5) * m * 0.008,
                            jy: (Math.random() - 0.5) * m * 0.008,
                            size: 0.34 + Math.random() * 0.52,
                            baseOpacity: 0.68 + Math.random() * 0.28,
                            glow: 2 + ((Math.random() * 2) | 0)
                        })
                    );
                }
            }
            for (vi = 0; vi < 6; vi++) {
                stars.push(
                    visBase({
                        motif: 'benzInner',
                        vi: vi,
                        bzCxN: bzCxN,
                        bzCyN: bzCyN,
                        bzR2N: bzR2N,
                        rotK: rotK * 0.62,
                        angJ: (Math.random() - 0.5) * 0.28,
                        radJ: 1 + (Math.random() - 0.5) * 0.12,
                        jx: (Math.random() - 0.5) * m * 0.01,
                        jy: (Math.random() - 0.5) * m * 0.01,
                        size: 0.48 + Math.random() * 0.55,
                        baseOpacity: 0.76 + Math.random() * 0.22,
                        glow: 2 + ((Math.random() * 2) | 0)
                    })
                );
            }
            var innerEdgeT = [0.26, 0.52, 0.78];
            for (vi = 0; vi < 6; vi++) {
                for (tei = 0; tei < innerEdgeT.length; tei++) {
                    stars.push(
                        visBase({
                            motif: 'benzInnerEdge',
                            vi: vi,
                            edgeT: innerEdgeT[tei],
                            bzCxN: bzCxN,
                            bzCyN: bzCyN,
                            bzR2N: bzR2N,
                            rotK: rotK * 0.62,
                            edgeAngJ: (Math.random() - 0.5) * 0.14,
                            radT: 0.96 + Math.random() * 0.08,
                            jx: (Math.random() - 0.5) * m * 0.007,
                            jy: (Math.random() - 0.5) * m * 0.007,
                            size: 0.3 + Math.random() * 0.4,
                            baseOpacity: 0.64 + Math.random() * 0.3,
                            glow: 2
                        })
                    );
                }
            }
            var pcCxN = 0.78;
            var pcCyN = 0.74;
            var pcRN = 0.132;
            for (vi = 0; vi < 5; vi++) {
                stars.push(
                    visBase({
                        motif: 'pent',
                        vi: vi,
                        pcCxN: pcCxN,
                        pcCyN: pcCyN,
                        pcRN: pcRN,
                        rotK: rotK * 0.5,
                        angJ: (Math.random() - 0.5) * 0.22,
                        radJ: 1 + (Math.random() - 0.5) * 0.1,
                        jx: (Math.random() - 0.5) * m * 0.014,
                        jy: (Math.random() - 0.5) * m * 0.014,
                        size: 0.82 + Math.random() * 0.78,
                        baseOpacity: 0.86 + Math.random() * 0.14,
                        glow: 3 + ((Math.random() * 2) | 0)
                    })
                );
            }
            var pentEdgeT = [0.2, 0.42, 0.65, 0.88];
            for (vi = 0; vi < 5; vi++) {
                for (tei = 0; tei < pentEdgeT.length; tei++) {
                    stars.push(
                        visBase({
                            motif: 'pentEdge',
                            vi: vi,
                            edgeT: pentEdgeT[tei],
                            pcCxN: pcCxN,
                            pcCyN: pcCyN,
                            pcRN: pcRN,
                            rotK: rotK * 0.5,
                            edgeAngJ: (Math.random() - 0.5) * 0.12,
                            radT: 0.97 + Math.random() * 0.06,
                            jx: (Math.random() - 0.5) * m * 0.008,
                            jy: (Math.random() - 0.5) * m * 0.008,
                            size: 0.32 + Math.random() * 0.48,
                            baseOpacity: 0.66 + Math.random() * 0.3,
                            glow: 2 + ((Math.random() * 2) | 0)
                        })
                    );
                }
            }
            for (vi = 0; vi < 5; vi++) {
                stars.push(
                    visBase({
                        motif: 'pentBond',
                        vi: vi,
                        pcCxN: pcCxN,
                        pcCyN: pcCyN,
                        pcRN: pcRN,
                        bondRFrac: 0.88 + Math.random() * 0.08,
                        rotK: rotK * 0.5,
                        bondAngJ: (Math.random() - 0.5) * 0.16,
                        jx: (Math.random() - 0.5) * m * 0.008,
                        jy: (Math.random() - 0.5) * m * 0.008,
                        size: 0.38 + Math.random() * 0.42,
                        baseOpacity: 0.7 + Math.random() * 0.28,
                        glow: 2
                    })
                );
            }
        }

        function updateScienceMotifs(now) {
            var rot0 = patternMotifRotate ? now : 0;
            var cw = canvas.width;
            var ch = canvas.height;
            var m2 = Math.min(cw, ch);
            var motifDrift = 0.42;
            var helixBx =
                (Math.sin(now * 8.2e-5) * cw * 0.052 + Math.sin(now * 4.65e-5 + 1.85) * cw * 0.034) *
                motifDrift;
            var helixBy =
                (Math.cos(now * 7.05e-5 + 0.42) * ch * 0.041 + Math.sin(now * 5.55e-5) * ch * 0.025) *
                motifDrift;
            var ringBx = Math.sin(now * 6.2e-5 + 2.7) * cw * 0.045 * motifDrift;
            var ringBy = Math.cos(now * 7.4e-5 + 1.1) * ch * 0.036 * motifDrift;
            var pentPBx = Math.sin(now * 5.4e-5 + 4.2) * cw * 0.04 * motifDrift;
            var pentPBy = Math.cos(now * 6.1e-5 + 2.3) * ch * 0.032 * motifDrift;
            var i;
            var pi = Math.PI;
            for (i = 0; i < patternStars.length; i++) {
                var s = patternStars[i];
                var rk = s.rotK * rot0;
                if (s.motif === 'dna') {
                    var dnaCx = cw * s.dnaCxN + helixBx;
                    var dnaY0 = ch * s.dnaY0N + helixBy;
                    var dnaH = ch * s.dnaHN;
                    var dnaR = m2 * s.dnaRN;
                    var mcy = dnaY0 + dnaH * 0.5;
                    var tn = Math.max(1, s.nStr - 1);
                    var yf = s.ti / tn;
                    var yy = dnaY0 + yf * dnaH + s.yNudge;
                    var hp =
                        typeof s.helixPhase === 'number' && isFinite(s.helixPhase) ? s.helixPhase : 0;
                    var pnD = typeof s.phaseNudge === 'number' ? s.phaseNudge : 0;
                    var tt =
                        yf * s.dnaTurns * pi * 2 +
                        hp +
                        pnD +
                        (s.strand === 1 ? pi : 0) +
                        rk;
                    var Rloc =
                        dnaR *
                        s.radMul *
                        (1 + 0.07 * Math.sin(yf * s.dnaTurns * pi * 4 + (s.strand || 0)));
                    var xFlat = Rloc * Math.cos(tt);
                    var yFlat = yy - mcy;
                    var tiltR0 =
                        typeof s.helixTiltRad === 'number' && isFinite(s.helixTiltRad) ? s.helixTiltRad : -0.12;
                    var ca = Math.cos(tiltR0);
                    var sa = Math.sin(tiltR0);
                    s.x = dnaCx + xFlat * ca - yFlat * sa + s.jx;
                    s.y = mcy + yFlat * ca + xFlat * sa + s.jy;
                } else if (s.motif === 'dnaRung') {
                    dnaCx = cw * s.dnaCxN + helixBx;
                    dnaY0 = ch * s.dnaY0N + helixBy;
                    dnaH = ch * s.dnaHN;
                    dnaR = m2 * s.dnaRN;
                    mcy = dnaY0 + dnaH * 0.5;
                    tn = Math.max(1, s.nStr - 1);
                    var yfR = typeof s.tiFrac === 'number' ? s.tiFrac : s.ti / tn;
                    yfR = Math.max(0, Math.min(1, yfR));
                    yy = dnaY0 + yfR * dnaH + (typeof s.yNudge === 'number' ? s.yNudge : 0);
                    hp = typeof s.helixPhase === 'number' && isFinite(s.helixPhase) ? s.helixPhase : 0;
                    var pn = typeof s.phaseNudge === 'number' ? s.phaseNudge : 0;
                    var tt0 = yfR * s.dnaTurns * pi * 2 + hp + pn + rk;
                    var tt1 = tt0 + pi;
                    var rm = typeof s.radMul === 'number' ? s.radMul : 1;
                    Rloc = dnaR * rm * (1 + 0.07 * Math.sin(yfR * s.dnaTurns * pi * 4));
                    var xA = Rloc * Math.cos(tt0);
                    var xB = Rloc * Math.cos(tt1);
                    var chordT = typeof s.chordT === 'number' ? s.chordT : 0.5;
                    var xFlatR = xA + (xB - xA) * chordT;
                    var yFlatR = yy - mcy;
                    tiltR0 =
                        typeof s.helixTiltRad === 'number' && isFinite(s.helixTiltRad) ? s.helixTiltRad : -0.12;
                    ca = Math.cos(tiltR0);
                    sa = Math.sin(tiltR0);
                    s.x = dnaCx + xFlatR * ca - yFlatR * sa + s.jx;
                    s.y = mcy + yFlatR * ca + xFlatR * sa + s.jy;
                } else if (s.motif === 'benz') {
                    var bzCx = cw * s.bzCxN + ringBx;
                    var bzCy = ch * s.bzCyN + ringBy;
                    var ang = pi / 6 + (s.vi / 6) * pi * 2 + s.angJ + rk;
                    var Rb = m2 * s.bzRN * s.radJ;
                    s.x = bzCx + Rb * Math.cos(ang) + s.jx;
                    s.y = bzCy + Rb * Math.sin(ang) + s.jy;
                } else if (s.motif === 'benzBond') {
                    bzCx = cw * s.bzCxN + ringBx;
                    bzCy = ch * s.bzCyN + ringBy;
                    var v0 = s.vi;
                    var a0 = pi / 6 + (v0 / 6) * pi * 2 + rk;
                    var a1 = pi / 6 + ((v0 + 1) / 6) * pi * 2 + rk;
                    ang = (a0 + a1) / 2 + s.bondAngJ;
                    var bondR = m2 * s.bzRN * s.bondRFrac;
                    s.x = bzCx + bondR * Math.cos(ang) + s.jx;
                    s.y = bzCy + bondR * Math.sin(ang) + s.jy;
                } else if (s.motif === 'benzEdge') {
                    bzCx = cw * s.bzCxN + ringBx;
                    bzCy = ch * s.bzCyN + ringBy;
                    var vvi = s.vi;
                    var et = s.edgeT;
                    var aa0 = pi / 6 + (vvi / 6) * pi * 2 + rk;
                    var aa1 = pi / 6 + ((vvi + 1) / 6) * pi * 2 + rk;
                    var aang = aa0 + (aa1 - aa0) * et + s.edgeAngJ;
                    Rb = m2 * s.bzRN * s.radT;
                    s.x = bzCx + Rb * Math.cos(aang) + s.jx;
                    s.y = bzCy + Rb * Math.sin(aang) + s.jy;
                } else if (s.motif === 'benzInner') {
                    bzCx = cw * s.bzCxN + ringBx;
                    bzCy = ch * s.bzCyN + ringBy;
                    ang = pi / 3 + (s.vi / 6) * pi * 2 + s.angJ + rk;
                    Rb = m2 * s.bzR2N * s.radJ;
                    s.x = bzCx + Rb * Math.cos(ang) + s.jx;
                    s.y = bzCy + Rb * Math.sin(ang) + s.jy;
                } else if (s.motif === 'benzInnerEdge') {
                    bzCx = cw * s.bzCxN + ringBx;
                    bzCy = ch * s.bzCyN + ringBy;
                    vvi = s.vi;
                    et = s.edgeT;
                    aa0 = pi / 3 + (vvi / 6) * pi * 2 + rk;
                    aa1 = pi / 3 + ((vvi + 1) / 6) * pi * 2 + rk;
                    aang = aa0 + (aa1 - aa0) * et + s.edgeAngJ;
                    Rb = m2 * s.bzR2N * s.radT;
                    s.x = bzCx + Rb * Math.cos(aang) + s.jx;
                    s.y = bzCy + Rb * Math.sin(aang) + s.jy;
                } else if (s.motif === 'pent') {
                    var pcCx = cw * s.pcCxN + pentPBx;
                    var pcCy = ch * s.pcCyN + pentPBy;
                    ang = -pi / 2 + (s.vi / 5) * pi * 2 + s.angJ + rk;
                    var Rp = m2 * s.pcRN * s.radJ;
                    s.x = pcCx + Rp * Math.cos(ang) + s.jx;
                    s.y = pcCy + Rp * Math.sin(ang) + s.jy;
                } else if (s.motif === 'pentEdge') {
                    pcCx = cw * s.pcCxN + pentPBx;
                    pcCy = ch * s.pcCyN + pentPBy;
                    vvi = s.vi;
                    et = s.edgeT;
                    aa0 = -pi / 2 + (vvi / 5) * pi * 2 + rk;
                    aa1 = -pi / 2 + ((vvi + 1) / 5) * pi * 2 + rk;
                    aang = aa0 + (aa1 - aa0) * et + s.edgeAngJ;
                    Rp = m2 * s.pcRN * s.radT;
                    s.x = pcCx + Rp * Math.cos(aang) + s.jx;
                    s.y = pcCy + Rp * Math.sin(aang) + s.jy;
                } else if (s.motif === 'pentBond') {
                    pcCx = cw * s.pcCxN + pentPBx;
                    pcCy = ch * s.pcCyN + pentPBy;
                    var pv = s.vi;
                    var p0 = -pi / 2 + (pv / 5) * pi * 2 + rk;
                    var p1 = -pi / 2 + ((pv + 1) / 5) * pi * 2 + rk;
                    ang = (p0 + p1) / 2 + s.bondAngJ;
                    var pb = m2 * s.pcRN * s.bondRFrac;
                    s.x = pcCx + pb * Math.cos(ang) + s.jx;
                    s.y = pcCy + pb * Math.sin(ang) + s.jy;
                }
            }
        }

        function initStars() {
            stars.length = 0;
            backdropStars.length = 0;
            patternStars.length = 0;
            var w = canvas.width || 800;
            var h = canvas.height || 600;
            var i;
            var starCount = getBackdropStarCount(w, h);
            for (i = 0; i < starCount; i++) {
                var s = {};
                spawnStar(s, w, h);
                stars.push(s);
                backdropStars.push(s);
            }
            pushScienceMotifStars(w, h);
            for (i = 0; i < stars.length; i++) {
                if (stars[i].isPattern) {
                    patternStars.push(stars[i]);
                }
            }
            activeStarOffsets = false;
        }

        function refreshBackdropCache(w, h) {
            if (!backdropCacheCtx) return;
            if (backdropCacheCanvas.width === w && backdropCacheCanvas.height === h) return;
            backdropCacheCanvas.width = w;
            backdropCacheCanvas.height = h;
            var cx = w * 0.5;
            var cy = h * 0.5;
            var rad = Math.max(w, h) * 0.98;
            var g = backdropCacheCtx.createRadialGradient(cx, cy, 0, cx, cy, rad);
            g.addColorStop(0, '#0a0f24');
            g.addColorStop(0.5, '#040714');
            g.addColorStop(1, '#000000');
            backdropCacheCtx.clearRect(0, 0, w, h);
            backdropCacheCtx.fillStyle = g;
            backdropCacheCtx.fillRect(0, 0, w, h);
        }

        function resizeCanvas() {
            var heroSec = document.getElementById('panshi-hero-section');
            var w =
                heroSec && heroSec.clientWidth > 2
                    ? heroSec.clientWidth
                    : container.clientWidth || window.innerWidth || 0;
            var h =
                heroSec && heroSec.clientHeight > 2
                    ? heroSec.clientHeight
                    : container.clientHeight || window.innerHeight || 0;
            if (w < 2 || h < 2) {
                w = window.innerWidth || 800;
                h = window.innerHeight || 600;
            }
            if (w < 2 || h < 2) return;
            w = Math.round(w);
            h = Math.round(h);
            if (canvas.width === w && canvas.height === h && stars.length > 0) {
                return;
            }
            canvas.width = w;
            canvas.height = h;
            bhEnterStartMs = null;
            initStars();
            refreshBackdropCache(w, h);
        }

        function drawDeepSpaceBackground(w, h) {
            refreshBackdropCache(w, h);
            if (backdropCacheCanvas.width === w && backdropCacheCanvas.height === h) {
                ctx.drawImage(backdropCacheCanvas, 0, 0, w, h);
            }
        }

        function drawOneStar(s, now) {
            var op = s.baseOpacity * (0.75 + 0.25 * Math.sin(now * s.twinkleSpeed + s.twinklePhase));
            if (op < 0.06) op = 0.06;
            if (op > 1) op = 1;
            var px = s.x + s.ox;
            var py = s.y + s.oy;
            ctx.fillStyle = 'rgba(220, 235, 255, ' + op + ')';
            if (s.isTiny) {
                ctx.shadowBlur = 0;
                ctx.shadowColor = 'transparent';
                ctx.fillRect(px, py, 1.15, 1.15);
                return;
            }
            if (s.useGlow) {
                ctx.shadowBlur = s.glow;
                ctx.shadowColor = 'rgba(220, 235, 255, ' + (op * 0.85) + ')';
            } else {
                ctx.shadowBlur = 0;
                ctx.shadowColor = 'transparent';
            }
            ctx.beginPath();
            ctx.arc(px, py, s.size, 0, Math.PI * 2);
            ctx.fill();
        }

        /** 科学图案与背景星同一套颜色与闪烁，仅尺寸/排布不同 */
        function drawPatternStar(s, now) {
            drawOneStar(s, now);
        }

        function drawBackdropStars(now) {
            var i;
            for (i = 0; i < backdropStars.length; i++) {
                drawOneStar(backdropStars[i], now);
            }
        }

        function drawPatternStars(now) {
            var i;
            for (i = 0; i < patternStars.length; i++) {
                drawPatternStar(patternStars[i], now);
            }
        }

        function render(ts) {
            if (stopped || !isActive) {
                rafId = 0;
                return;
            }
            if (canvas.width < 2 || canvas.height < 2) {
                resizeCanvas();
                rafId = requestAnimationFrame(render);
                return;
            }
            var now = ts != null ? ts : performance.now();
            if (lastRenderTs && now - lastRenderTs < TARGET_FRAME_MS) {
                rafId = requestAnimationFrame(render);
                return;
            }
            lastRenderTs = now;
            var dt = lastTs > 0 ? Math.min(0.05, (now - lastTs) / 1000) : 0.016;
            lastTs = now;

            var i;
            var width = canvas.width;
            var height = canvas.height;
            var floatY = Math.sin(now * 0.00032) * 5;

            for (i = 0; i < backdropStars.length; i++) {
                var star = backdropStars[i];
                star.x += star.speedX * dt * 60 * STARFIELD_TIME_SCALE;
                star.y += star.speedY * dt * 60 * STARFIELD_TIME_SCALE;
                if (star.x < 0) star.x += width;
                else if (star.x >= width) star.x -= width;
                if (star.y < 0) star.y += height;
                else if (star.y >= height) star.y -= height;
            }
            updateScienceMotifs(now);

            if (heroStarRepelEnabled) {
                var repelR = Math.min(width, height) * 0.19;
                var repelStr = 920;
                var dampIn = 1 - Math.min(1, 4.2 * dt);
                var maxOff = Math.min(width, height) * 0.065;
                var maxOff2 = maxOff * maxOff;
                if (mouseInHero) {
                    activeStarOffsets = true;
                    for (i = 0; i < stars.length; i++) {
                        star = stars[i];
                        var px = star.x + star.ox;
                        var py = star.y + star.oy;
                        var dx = px - mouseCx;
                        var dy = py - mouseCy;
                        var d = Math.sqrt(dx * dx + dy * dy);
                        if (d < repelR && d > 0.8) {
                            var fall = 1 - d / repelR;
                            var push = repelStr * fall * fall * dt;
                            star.ox += (dx / d) * push;
                            star.oy += (dy / d) * push;
                        }
                        star.ox *= dampIn;
                        star.oy *= dampIn;
                        var o2 = star.ox * star.ox + star.oy * star.oy;
                        if (o2 > maxOff2 && o2 > 1e-6) {
                            var nd = Math.sqrt(o2);
                            star.ox = (star.ox / nd) * maxOff;
                            star.oy = (star.oy / nd) * maxOff;
                        }
                    }
                } else if (activeStarOffsets) {
                    var k = Math.min(1, 15 * dt);
                    activeStarOffsets = false;
                    for (i = 0; i < stars.length; i++) {
                        star = stars[i];
                        star.ox += (0 - star.ox) * k;
                        star.oy += (0 - star.oy) * k;
                        if (Math.abs(star.ox) > 0.02 || Math.abs(star.oy) > 0.02) {
                            activeStarOffsets = true;
                        } else {
                            star.ox = 0;
                            star.oy = 0;
                        }
                    }
                }
            }

            drawDeepSpaceBackground(width, height);
            ctx.globalCompositeOperation = 'source-over';
            drawBackdropStars(now);
            drawPatternStars(now);
            ctx.shadowBlur = 0;
            ctx.shadowColor = 'transparent';

            if (blackHoleImg.complete && blackHoleImg.width > 0) {
                if (bhEnterStartMs === null) {
                    bhEnterStartMs = now;
                }
                var rawT = (now - bhEnterStartMs) / BH_ENTER_RAMP_MS;
                var enterT = rawT >= 1 ? 1 : Math.min(1, Math.max(0, rawT));
                var baseScale =
                    Math.min(width / blackHoleImg.width, height / blackHoleImg.height) * 0.88 * BH_SCALE_MUL;
                var sizeBreathe = 1 + Math.sin(now * 0.001) * 0.02;
                var bw = blackHoleImg.width * baseScale * sizeBreathe;
                var bh = blackHoleImg.height * baseScale * sizeBreathe;
                var bhCx = width * BH_CENTER_X_FRAC;
                var bhCy = window.innerWidth < 768 ? height * 0.75 : height / 2;
                var alphaBreathe = 0.98 + 0.02 * Math.sin(now * 0.00085);
                var bhAlpha = enterT * BH_ENTER_MAX_OPACITY * alphaBreathe;
                ctx.save();
                ctx.globalCompositeOperation = 'screen';
                ctx.globalAlpha = bhAlpha;
                ctx.shadowBlur = 0;
                ctx.shadowColor = 'transparent';
                ctx.drawImage(
                    blackHoleImg,
                    bhCx - bw / 2,
                    bhCy - bh / 2 + floatY,
                    bw,
                    bh
                );
                ctx.restore();
                if (gonngshiImg.complete && gonngshiImg.width > 0) {
                    var cx = bhCx;
                    var cy = bhCy + floatY;
                    ctx.save();
                    ctx.globalCompositeOperation = 'screen';
                    ctx.globalAlpha = bhAlpha * 0.92;
                    ctx.shadowBlur = 0;
                    ctx.shadowColor = 'transparent';
                    ctx.translate(cx, cy);
                    ctx.rotate(now * GONGSHI_ROTATE_RAD_PER_MS);
                    ctx.drawImage(gonngshiImg, -bw / 2, -bh / 2, bw, bh);
                    ctx.restore();
                }
                ctx.globalAlpha = 1;
                ctx.globalCompositeOperation = 'source-over';
            }

            rafId = requestAnimationFrame(render);
        }

        function bootStarfield() {
            resizeCanvas();
            if (stars.length === 0) {
                var w = window.innerWidth || 800;
                var h = window.innerHeight || 600;
                canvas.width = w;
                canvas.height = h;
                initStars();
                refreshBackdropCache(w, h);
            }
        }
        bootStarfield();
        if (typeof ResizeObserver !== 'undefined') {
            var heroSecEl = document.getElementById('panshi-hero-section');
            new ResizeObserver(resizeCanvas).observe(heroSecEl || container);
        }
        window.addEventListener('resize', resizeCanvas);
        window.addEventListener('load', function () {
            bootStarfield();
        });
        if (heroStarRepelEnabled) {
            var heroSectionEl = container.closest('section');
            function syncPointerFromEvent(e) {
                if (stopped || !isActive || !heroSectionEl || canvas.width < 2) return;
                var sr = heroSectionEl.getBoundingClientRect();
                if (e.clientX >= sr.left && e.clientX <= sr.right && e.clientY >= sr.top && e.clientY <= sr.bottom) {
                    var cr = canvas.getBoundingClientRect();
                    var sx = canvas.width / Math.max(cr.width, 1);
                    var sy = canvas.height / Math.max(cr.height, 1);
                    mouseCx = (e.clientX - cr.left) * sx;
                    mouseCy = (e.clientY - cr.top) * sy;
                    mouseInHero = true;
                } else {
                    mouseInHero = false;
                }
            }
            window.addEventListener(
                'mousemove',
                function (e) {
                    syncPointerFromEvent(e);
                },
                { passive: true }
            );
            window.addEventListener(
                'touchmove',
                function (e) {
                    if (e.touches && e.touches[0]) {
                        var t = e.touches[0];
                        syncPointerFromEvent({ clientX: t.clientX, clientY: t.clientY });
                    }
                },
                { passive: true }
            );
            window.addEventListener(
                'touchend',
                function () {
                    mouseInHero = false;
                },
                { passive: true }
            );
            document.addEventListener(
                'mouseleave',
                function () {
                    mouseInHero = false;
                },
                { passive: true }
            );
        }
        function syncSceneState(nextActive) {
            var shouldActivate = !!nextActive;
            if (isActive === shouldActivate) return;
            isActive = shouldActivate;
            mouseInHero = false;
            activeStarOffsets = false;
            lastTs = 0;
            lastRenderTs = 0;
            if (isActive) {
                bootStarfield();
                if (!rafId) {
                    rafId = requestAnimationFrame(render);
                }
            } else if (rafId) {
                cancelAnimationFrame(rafId);
                rafId = 0;
            }
        }
        document.addEventListener('hero:slidechange', function (e) {
            var activeSection = e && e.detail ? e.detail.section : null;
            syncSceneState(activeSection === heroSlide);
        });
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) {
                lastTs = 0;
                lastRenderTs = 0;
                mouseInHero = false;
                activeStarOffsets = false;
                if (rafId) {
                    cancelAnimationFrame(rafId);
                    rafId = 0;
                }
            } else if (isActive && !rafId) {
                rafId = requestAnimationFrame(render);
            }
        });
        (function scheduleBootRetries() {
            var n = 0;
            function tick() {
                if (stars.length > 0 && container.clientWidth >= 2) return;
                if (n++ >= 90) return;
                bootStarfield();
                requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        })();
        if (isActive) {
            rafId = requestAnimationFrame(render);
        }

        stopHeroStarfield = function () {
            stopped = true;
            if (rafId) cancelAnimationFrame(rafId);
        };
    })();

    (function heroSignatureReveal() {
        var wrap = document.getElementById('hero-signature-wrap');
        if (wrap) {
            setTimeout(function () {
                wrap.classList.add('hero-signature-wrap--active');
            }, 1000);
        }
    })();

    // 流体背景跟随鼠标动效
    (function() {
        const heroSlide = document.getElementById('hero-panshi-slide');
        const fluidBg = document.getElementById('fluid-bg');
        if (!heroSlide || !fluidBg) return;

        const blobs = fluidBg.querySelectorAll('.fluid-blob');
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let currentX = mouseX;
        let currentY = mouseY;
        let rafId = null;
        let isActive = heroSlide.classList.contains('hero-section--active');
        let lastFrameTs = 0;
        const targetFrameMs = 1000 / 30;

        // 鼠标移动监听
        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
        }, { passive: true });

        // 平滑动画
        function animate(ts) {
            if (!isActive) return;
            const now = typeof ts === 'number' ? ts : performance.now();
            if (lastFrameTs && now - lastFrameTs < targetFrameMs) {
                rafId = requestAnimationFrame(animate);
                return;
            }
            lastFrameTs = now;

            // 线性插值，使移动更平滑
            currentX += (mouseX - currentX) * 0.05;
            currentY += (mouseY - currentY) * 0.05;

            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;

            // 计算偏移量（相对于屏幕中心）
            const offsetX = (currentX - centerX) / centerX;
            const offsetY = (currentY - centerY) / centerY;

            // 为每个 blob 设置不同的移动幅度，创造层次感
            blobs.forEach((blob, index) => {
                const factor = (index + 1) * 15; // 不同层级移动幅度不同
                const moveX = offsetX * factor;
                const moveY = offsetY * factor;

                // 添加轻微的呼吸效果
                const time = now * 0.001;
                const breathe = Math.sin(time + index) * 5;

                blob.style.transform = `translate3d(${moveX}px, ${moveY + breathe}px, 0)`;
            });

            rafId = requestAnimationFrame(animate);
        }

        // 启动动画
        if (isActive) {
            rafId = requestAnimationFrame(animate);
        }

        function syncFluidState(nextActive) {
            const shouldActivate = !!nextActive;
            if (isActive === shouldActivate) return;
            isActive = shouldActivate;
            lastFrameTs = 0;
            if (isActive) {
                if (!rafId) {
                    rafId = requestAnimationFrame(animate);
                }
             } else if (rafId) {
                cancelAnimationFrame(rafId);
                rafId = null;
            }
        }

        document.addEventListener('hero:slidechange', (e) => {
            const activeSection = e && e.detail ? e.detail.section : null;
            syncFluidState(activeSection === heroSlide);
        });

        // 页面不可见时暂停动画以节省性能
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                lastFrameTs = 0;
                if (rafId) cancelAnimationFrame(rafId);
                rafId = null;
            } else if (isActive && !rafId) {
                rafId = requestAnimationFrame(animate);
            }
        });
    })();
</script>
<script src="https://www.wenge.com/cityMini/site/static/wenge/claworksV3/script.js"></script>

	</body>
</html>
