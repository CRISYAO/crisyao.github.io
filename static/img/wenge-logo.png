		</div>

		<!-- 下拉沉浸式搜索面板 (桌面端) -->
		<div
			id="searchDropdownPanel"
			class="absolute top-[80px] left-0 w-full bg-white/95 backdrop-blur-xl shadow-xl border-t border-gray-100 origin-top transform scale-y-0 opacity-0 invisible transition-all duration-300 z-50 hidden lg:block"
		>
			<div class="max-w-[1000px] mx-auto px-6 py-10">
				<div class="relative flex items-center z-10">
					<i
						data-lucide="search"
						class="absolute left-6 w-6 h-6 text-gray-400 pointer-events-none z-20"
					></i>
					<input
						type="text"
						id="desktopSearchInput"
						placeholder="搜索产品、解决方案或动态..."
						class="w-full bg-white border border-indigo-400 focus:border-indigo-500 focus:shadow-[0_0_0_4px_rgba(99,102,241,0.15)] rounded-full pl-16 pr-14 py-4 text-base font-medium outline-none transition-all text-modern-dark relative z-10 pointer-events-auto"
					/>
					<button
						id="closeSearchBtn"
						class="absolute right-5 p-2 text-gray-400 hover:text-gray-600 transition-colors outline-none z-20 cursor-pointer pointer-events-auto rounded-full hover:bg-gray-100"
					>
						<i data-lucide="x" class="w-5 h-5 pointer-events-none"></i>
					</button>
				</div>
				<!-- 快捷热词推荐 -->
				<div class="mt-6 flex gap-5 justify-center text-sm text-gray-500 font-medium">
					<span class="text-gray-400">热门搜索:</span>
					<a
						href="/cityMini/site/search?query=雅意大模型"
						target="_blank"
						class="hover:text-indigo-600 transition-colors"
						>雅意大模型</a
					>
					<a
						href="/cityMini/site/search?query=智川X-Agent"
						target="_blank"
						class="hover:text-indigo-600 transition-colors"
						>智川X-Agent</a
					>
					<a
						href="/cityMini/site/search?query=红旗融媒体"
						target="_blank"
						class="hover:text-indigo-600 transition-colors"
						>红旗融媒体</a
					>
					<a
						href="/cityMini/site/search?query=社会计算"
						target="_blank"
						class="hover:text-indigo-600 transition-colors"
						>社会计算</a
					>
				</div>
			</div>
		</div>
	</div>
</nav>

<script>
	if (typeof lucide !== 'undefined') lucide.createIcons()

	// 导航栏滚动交互
	window.addEventListener('scroll', () => {
		const nav = document.querySelector('nav')
		if (window.scrollY > 20) {
			nav.classList.add('shadow-sm')
			nav.classList.replace('bg-white/80', 'bg-white/95')
		} else {
			nav.classList.remove('shadow-sm')
			nav.classList.replace('bg-white/95', 'bg-white/80')
		}
	})
	// 移动端菜单切换
	const mobileMenuBtn = document.getElementById('mobileMenuBtn')
	const mobileMenuDrawer = document.getElementById('mobileMenuDrawer')

	if (mobileMenuBtn && mobileMenuDrawer) {
		mobileMenuBtn.addEventListener('click', () => {
			mobileMenuDrawer.classList.toggle('translate-x-full')
		})
	}

	// 下拉菜单点击交互
	const navDropdowns = document.querySelectorAll('.nav-dropdown')
	let activeDropdown = null

	navDropdowns.forEach(dropdown => {
		const btn = dropdown.querySelector('.nav-dropdown-btn')
		const menu = dropdown.querySelector('.nav-dropdown-menu')
		const icon = dropdown.querySelector('.dropdown-icon')

		if (btn && menu) {
			btn.addEventListener('click', e => {
				e.stopPropagation()

				// 如果当前下拉菜单已经是打开的，则关闭它
				if (activeDropdown === dropdown) {
					menu.classList.remove('opacity-100', 'visible')
					menu.classList.add('opacity-0', 'invisible')
					if (icon) icon.classList.remove('rotate-180')
					activeDropdown = null
				} else {
					// 关闭其他打开的下拉菜单
					navDropdowns.forEach(d => {
						const m = d.querySelector('.nav-dropdown-menu')
						const i = d.querySelector('.dropdown-icon')
						if (m) {
							m.classList.remove('opacity-100', 'visible')
							m.classList.add('opacity-0', 'invisible')
						}
						if (i) i.classList.remove('rotate-180')
					})

					// 打开当前下拉菜单
					menu.classList.remove('opacity-0', 'invisible')
					menu.classList.add('opacity-100', 'visible')
					if (icon) icon.classList.add('rotate-180')
					activeDropdown = dropdown
				}
			})
		}
	})

	// 点击空白处关闭下拉菜单
	document.addEventListener('click', e => {
		if (activeDropdown && !activeDropdown.contains(e.target)) {
			navDropdowns.forEach(dropdown => {
				const menu = dropdown.querySelector('.nav-dropdown-menu')
				const icon = dropdown.querySelector('.dropdown-icon')
				if (menu) {
					menu.classList.remove('opacity-100', 'visible')
					menu.classList.add('opacity-0', 'invisible')
				}
				if (icon) icon.classList.remove('rotate-180')
			})
			activeDropdown = null
		}
	})

	// 搜索面板切换
	const searchToggleBtn = document.getElementById('searchToggleBtn')
	const searchDropdownPanel = document.getElementById('searchDropdownPanel')
	const closeSearchBtn = document.getElementById('closeSearchBtn')

	if (searchToggleBtn && searchDropdownPanel) {
		searchToggleBtn.addEventListener('click', e => {
			e.stopPropagation()
			const isClosed = searchDropdownPanel.classList.contains('scale-y-0')
			if (isClosed) {
				// 关闭导航下拉菜单
				navDropdowns.forEach(dropdown => {
					const menu = dropdown.querySelector('.nav-dropdown-menu')
					const icon = dropdown.querySelector('.dropdown-icon')
					if (menu) {
						menu.classList.remove('opacity-100', 'visible')
						menu.classList.add('opacity-0', 'invisible')
					}
					if (icon) icon.classList.remove('rotate-180')
				})
				activeDropdown = null

				searchDropdownPanel.classList.remove('scale-y-0', 'opacity-0', 'invisible')
				setTimeout(() => {
					const input = searchDropdownPanel.querySelector('input')
					if (input) input.focus()
				}, 300)
			} else {
				searchDropdownPanel.classList.add('scale-y-0', 'opacity-0', 'invisible')
			}
		})
	}

	if (closeSearchBtn && searchDropdownPanel) {
		closeSearchBtn.addEventListener('click', () => {
			searchDropdownPanel.classList.add('scale-y-0', 'opacity-0', 'invisible')
		})
	}

	// 点击页面其他区域关闭搜索面板
	document.addEventListener('click', e => {
		if (
			searchDropdownPanel &&
			!searchToggleBtn?.contains(e.target) &&
			!searchDropdownPanel.contains(e.target)
		) {
			searchDropdownPanel.classList.add('scale-y-0', 'opacity-0', 'invisible')
		}
	})

	const SEARCH_PAGE_BASE = '/cityMini/site/search?query='

	function openSiteSearch(query, options = {}) {
		const trimmedQuery = query.trim()
		if (!trimmedQuery) return

		const searchUrl = SEARCH_PAGE_BASE + encodeURIComponent(trimmedQuery)

		if (options.closeDesktopPanel && searchDropdownPanel) {
			searchDropdownPanel.classList.add('scale-y-0', 'opacity-0', 'invisible')
		}

		if (options.closeMobileDrawer && mobileMenuDrawer) {
			mobileMenuDrawer.classList.add('translate-x-full')
		}

		if (options.newTab) {
			window.open(searchUrl, '_blank')
			return
		}

		window.location.href = searchUrl
	}

	function bindSearchInput(input, options = {}) {
		if (!input) return

		let isComposing = false

		input.addEventListener('compositionstart', () => {
			isComposing = true
		})

		input.addEventListener('compositionend', () => {
			isComposing = false
		})

		input.addEventListener('keydown', e => {
			if (e.key === 'Enter' && !isComposing) {
				e.preventDefault()
				openSiteSearch(input.value, options)
			}
		})
	}

	// 桌面端与移动端共用搜索跳转
	const desktopSearchInput = document.getElementById('desktopSearchInput')
	const mobileSearchInput = document.getElementById('mobileSearchInput')
	const mobileSearchSubmitBtn = document.getElementById('mobileSearchSubmitBtn')

	bindSearchInput(desktopSearchInput, { newTab: true, closeDesktopPanel: true })
	bindSearchInput(mobileSearchInput, { closeMobileDrawer: true })

	if (mobileSearchSubmitBtn && mobileSearchInput) {
		mobileSearchSubmitBtn.addEventListener('click', () => {
			openSiteSearch(mobileSearchInput.value, { closeMobileDrawer: true })
		})
	}

	// DIOS 超级菜单选项卡切换
	const diosTabBtns = document.querySelectorAll('.dios-tab-btn')
	const diosContentPanes = document.querySelectorAll('.dios-content-pane')

	diosTabBtns.forEach(btn => {
		btn.addEventListener('click', e => {
			e.stopPropagation()
			const target = btn.dataset.target

			// 更新选项卡状态
			diosTabBtns.forEach(b => {
				b.classList.remove('font-bold', 'text-modern-dark', 'bg-white', 'border-indigo-600')
				b.classList.add(
					'font-medium',
					'text-gray-500',
					'hover:text-modern-dark',
					'hover:bg-gray-100',
					'border-transparent'
				)
			})

			btn.classList.remove(
				'font-medium',
				'text-gray-500',
				'hover:text-modern-dark',
				'hover:bg-gray-100',
				'border-transparent'
			)
			btn.classList.add('font-bold', 'text-modern-dark', 'bg-white', 'border-indigo-600')

			// 更新内容面板
			diosContentPanes.forEach(pane => {
				pane.classList.add('hidden')
			})

			const targetPane = document.getElementById(target)
			if (targetPane) {
				targetPane.classList.remove('hidden')
			}
		})
	})

	const mobileDiosTabBtns = document.querySelectorAll('.mobile-dios-tab-btn')
	const mobileDiosPanes = document.querySelectorAll('.mobile-dios-pane')

	mobileDiosTabBtns.forEach(btn => {
		btn.addEventListener('click', e => {
			e.stopPropagation()
			const target = btn.dataset.target

			mobileDiosTabBtns.forEach(b => {
				b.classList.remove('bg-white', 'text-indigo-600', 'font-semibold', 'shadow-sm')
				b.classList.add('text-gray-500', 'font-medium')
			})

			btn.classList.remove('text-gray-500', 'font-medium')
			btn.classList.add('bg-white', 'text-indigo-600', 'font-semibold', 'shadow-sm')

			mobileDiosPanes.forEach(pane => {
				pane.classList.add('hidden')
			})

			const targetPane = document.getElementById(target)
			if (targetPane) {
				targetPane.classList.remove('hidden')
			}
		})
	})

	// 行业产品超级菜单选项卡切换
	const industryTabBtns = document.querySelectorAll('.industry-tab-btn')
	const industryContentPanes = document.querySelectorAll('.industry-content-pane')

	industryTabBtns.forEach(btn => {
		btn.addEventListener('click', e => {
			e.stopPropagation()
			const target = btn.dataset.target

			// 更新选项卡状态
			industryTabBtns.forEach(b => {
				b.classList.remove('font-bold', 'text-modern-dark', 'bg-white', 'border-indigo-600')
				b.classList.add(
					'font-medium',
					'text-gray-500',
					'hover:text-modern-dark',
					'hover:bg-gray-100',
					'border-transparent'
				)
			})

			btn.classList.remove(
				'font-medium',
				'text-gray-500',
				'hover:text-modern-dark',
				'hover:bg-gray-100',
				'border-transparent'
			)
			btn.classList.add('font-bold', 'text-modern-dark', 'bg-white', 'border-indigo-600')

			// 更新内容面板
			industryContentPanes.forEach(pane => {
				pane.classList.add('hidden')
			})

			const targetPane = document.getElementById(target)
			if (targetPane) {
				targetPane.classList.remove('hidden')
			}
		})
	})

	const mobileIndustryTabBtns = document.querySelectorAll('.mobile-industry-tab-btn')
	const mobileIndustryPanes = document.querySelectorAll('.mobile-industry-pane')

	mobileIndustryTabBtns.forEach(btn => {
		btn.addEventListener('click', e => {
			e.stopPropagation()
			const target = btn.dataset.target

			mobileIndustryTabBtns.forEach(b => {
				b.classList.remove('bg-white', 'text-indigo-600', 'font-semibold', 'shadow-sm')
				b.classList.add('text-gray-500', 'font-medium')
			})

			btn.classList.remove('text-gray-500', 'font-medium')
			btn.classList.add('bg-white', 'text-indigo-600', 'font-semibold', 'shadow-sm')

			mobileIndustryPanes.forEach(pane => {
				pane.classList.add('hidden')
			})

			const targetPane = document.getElementById(target)
			if (targetPane) {
				targetPane.classList.remove('hidden')
			}
		})
	})

	// 初始化语言切换按钮
	const YAYI_ZH_URL = 'https://YAYI.wenge.com/maas/#/HeaderNav/home'
	const YAYI_EN_URL = 'https://YAYI.wenge.com/maas/?lang=en'

	function getYAYIProductUrl() {
		try {
			if (window.i18n && typeof window.i18n.getCurrentLanguage === 'function') {
				return window.i18n.getCurrentLanguage() === 'en' ? YAYI_EN_URL : YAYI_ZH_URL
			}

			const savedLang = localStorage.getItem('wenge_lang') || localStorage.getItem('lang')
			return savedLang === 'en' ? YAYI_EN_URL : YAYI_ZH_URL
		} catch (error) {
			return YAYI_ZH_URL
		}
	}

	window.getYAYIProductUrl = getYAYIProductUrl

	function syncYAYILinks(root = document) {
		const targetUrl = getYAYIProductUrl()
		root.querySelectorAll('[data-YAYI-link="true"]').forEach(link => {
			link.setAttribute('href', targetUrl)
		})
	}

	const langToggleBtn = document.getElementById('langToggleBtn')
	const langText = document.getElementById('langText')
	const logoZh = document.getElementById('logoZh')
	const logoEn = document.getElementById('logoEn')
	function updateLangText() {
		syncYAYILinks()
		if (langText) {
			const currentLang = window.i18n ? window.i18n.getCurrentLanguage() : 'zh'
			langText.textContent = currentLang === 'zh' ? 'EN' : '中文'
			if (currentLang === 'en') {
				logoEn.classList.remove('hidden')
				logoZh.classList.add('hidden')
			} else {
				logoEn.classList.add('hidden')
				logoZh.classList.remove('hidden')
			}
		}
	}
	updateLangText()
	if (langToggleBtn) {
		langToggleBtn.addEventListener('click', function () {
			if (window.i18n) {
				const currentLang = window.i18n.getCurrentLanguage()
				const newLang = currentLang === 'zh' ? 'en' : 'zh'
				window.i18n.setLanguage(newLang)
				updateLangText()
			}
		})
	}
	window.addEventListener('languageChanged', updateLangText)

	// 如果当前是英文，翻译header内容
	if (window.i18n && window.i18n.getCurrentLanguage() === 'en') {
		window.i18n.translatePageContent()
	}
</script>


		<!-- 首屏轮播容器 -->
		<div class="relative w-full h-[100vh] min-h-[800px] overflow-hidden" >

            <!-- 1. 首屏 dip -->
            <section class="hero hero-section absolute inset-0 w-full h-full bg-[#fafafa] font-sans-panshi transition-opacity duration-700 ease-in-out">
                <div class="tipbody theme-palantir">
				
					<div id="hero-section" class="relative min-h-screen flex flex-col justify-center py-20 overflow-hidden">
        
						<!-- Background Animations & Canvas -->
						<div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
							<div class="absolute top-[5%] right-[5%] w-[800px] h-[800px] rounded-full bg-blue-100/40 blur-[100px] animate-blob-1"></div>
							<div class="absolute bottom-[5%] left-[5%] w-[600px] h-[600px] rounded-full bg-indigo-100/40 blur-[100px] animate-blob-2"></div>
							
							<!-- Canvas 画布 -->
							<canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-auto opacity-30"></canvas>
						</div>
				
						<!-- 核心内容区域 (偏左侧布局) -->
						<div class="w-full mx-auto px-4 sm:px-6 lg:px-12 relative z-10" style="position: relative;top: 10px;">
							<!-- 文本内容限制宽度，自然形成左对齐 -->
